{
 "_doc": "Recipe for tools/bp3d_build.py. Each part = union of selectors. fma: 'FMAid@part_of|is_a' (composite concept). name: regex on element names (case-insensitive). within: limit name matches to a concept. not: regex to drop. zmin/zmax: element bbox centre height in BodyParts3D mm (head is z 1420-1640).",
 "brain":       { "fma": ["FMA50801@part_of"], "not": "ventricle|aqueduct|canal" },
 "skull":       { "fma": ["FMA46565@part_of"], "name": "bone|maxilla|vomer|concha|ethmoid|sphenoid|occipital|frontal|parietal|temporal|zygomatic|nasal|lacrimal|palatine", "within": "FMA46565@part_of", "not": "mandible" },
 "mandible":    { "name": "^mandible$" },
 "tongue":      { "name": "^tongue$" },
 "softpalate":  { "name": "soft palate|uvula|palatoglossus|levator veli|tensor veli|musculus uvulae" },
 "nerves":      { "name": "trigeminal|ophthalmic nerve|maxillary nerve|mandibular nerve|infraorbital|supraorbital|supratrochlear|lingual nerve|alveolar nerve|nasociliary|frontal nerve|lacrimal nerve|zygomatic nerve|auriculotemporal|buccal nerve|mental nerve|palatine nerve", "not": "artery|vein" },
 "nervous":     { "name": "nerve", "zmin": 1420, "not": "artery|vein" },
 "carotid":     { "name": "carotid", "not": "vein|sinus nerve" },
 "circle":      { "fma": ["FMA50454@part_of"] },
 "aca":         { "name": "anterior cerebral artery" },
 "mca":         { "name": "middle cerebral artery" },
 "basilar":     { "name": "basilar artery|vertebral artery|posterior cerebral artery|cerebellar artery" },
 "head_arteries": { "fma": ["FMA50720@is_a"], "zmin": 1450 },

 "heartwall":   { "name": "^wall of |myocardium|interventricular septum|interatrial septum" , "within": "FMA7088@part_of" },
 "heart":       { "fma": ["FMA7088@part_of"], "not": "^wall of |myocardium|interventricular septum|interatrial septum" },
 "lungR":       { "fma": ["FMA7333@part_of"] },
 "lungL":       { "fma": ["FMA7370@part_of"] },
 "liver":       { "fma": ["FMA7197@part_of"] },
 "stomach":     { "name": "^stomach$" },
 "smallint":    { "fma": ["FMA7200@part_of"], "not": "mesentery" },
 "largeint":    { "fma": ["FMA7201@part_of"], "name": "rectum|cecum|caecum|appendix|colon", "not": "artery|vein|nerve" },
 "kidneyR":     { "name": "^right kidney$" },
 "kidneyL":     { "name": "^left kidney$" },
 "ureters":     { "name": "ureter", "not": "artery|vein|nerve" },
 "esophagus":   { "name": "^esophagus$" },
 "trachea":     { "name": "^trachea$|main bronchus" },
 "diaphragm":   { "name": "^diaphragm$" },
 "ribcage":     { "fma": ["FMA7480@part_of"] },
 "spine":       { "fma": ["FMA13478@part_of"] },
 "pelvis":      { "fma": ["FMA16580@part_of"] },
 "spinalcord":  { "fma": ["FMA7647@part_of"] },
 "arteries_all":{ "fma": ["FMA50720@is_a"] },
 "veins_all":   { "fma": ["FMA50723@is_a"] },
 "pancreas":    { "name": "pancreas", "not": "artery|vein|duct|nerve|branch" },
 "spleen":      { "name": "^spleen$" },
 "bladder":     { "name": "^urinary bladder$" },
 "gallbladder": { "name": "^gallbladder$" },
 "adrenals":    { "fma": ["FMA9604@is_a"] },
 "hypothalamus":{ "name": "hypothalamus|mammillary body|tuber cinereum" },
 "skin":        { "name": "^skin$" }
}
