[
 {
  "line": "A town has two barbers:",
  "image": "163985121_1794345470350100.jpg"
 },
 {
  "line": "one with a perfect haircut,",
  "image": "608827054_1794345471614937.jpg"
 },
 {
  "line": "and one with a terrible one.",
  "image": "236747705_1794345472764310.jpg"
 },
 {
  "line": "A stranger walks past",
  "image": "500144351_1794345474034326.jpg"
 },
 {
  "line": "the perfect one",
  "image": "897691956_1794345475258124.jpg"
 },
 {
  "line": "and sits down with the butcher.",
  "image": "138210363_1794345476196263.jpg"
 },
 {
  "line": "That's what the town calls him,",
  "image": "952247804_1794345477266523.jpg"
 },
 {
  "line": "because his hair looks like",
  "image": "90205978_1794345478212810.jpg"
 },
 {
  "line": "it was cut in the dark",
  "image": "46861430_1794345479194664.jpg"
 },
 {
  "line": "with a fork.",
  "image": "284034240_1794345480156858.jpg"
 },
 {
  "line": "So the whole street",
  "image": "542065779_1794345481509360.jpg"
 },
 {
  "line": "stops to watch.",
  "image": "942571094_1794345482509547.jpg"
 },
 {
  "line": "The barber with the perfect hair",
  "image": "615178440_1794345483555945.jpg"
 },
 {
  "line": "holds his door open and yells,",
  "image": "701554074_1794345484613770.jpg"
 },
 {
  "line": "\"Last chance, friend!\"",
  "image": "750556343_1794345485573084.jpg"
 },
 {
  "line": "Someone starts taking bets",
  "image": "458036232_1794345486705341.jpg"
 },
 {
  "line": "on whether the stranger",
  "image": "752141806_1794345487719973.jpg"
 },
 {
  "line": "keeps his ears.",
  "image": "24343393_1794345488739838.jpg"
 },
 {
  "line": "And soon,",
  "image": "649151292_1794345489808074.jpg"
 },
 {
  "line": "half the town is pressed",
  "image": "494790637_1794345490824806.jpg"
 },
 {
  "line": "against the window",
  "image": "276506498_1794345491794691.jpg"
 },
 {
  "line": "as the scissors go up.",
  "image": "404424729_1794345492786085.jpg"
 },
 {
  "line": "Then, the butcher",
  "image": "367914438_1794345493814802.jpg"
 },
 {
  "line": "spins the chair around,",
  "image": "521944592_1794345494890096.jpg"
 },
 {
  "line": "and it's the best haircut",
  "image": "644992596_1794345496004138.jpg"
 },
 {
  "line": "any of them have ever seen.",
  "image": "825792658_1794345496975106.jpg"
 },
 {
  "line": "Wait, what?",
  "image": "165034791_1794345497883907.jpg"
 },
 {
  "line": "You see,",
  "image": "879001984_1794345498845295.jpg"
 },
 {
  "line": "a barber can't cut",
  "image": "638638498_1794345499815299.jpg"
 },
 {
  "line": "his own hair,",
  "image": "1032876202_1794345500705487.jpg"
 },
 {
  "line": "and this town",
  "image": "393983494_1794345501788704.jpg"
 },
 {
  "line": "only has two barbers,",
  "image": "871026839_1794345502763342.jpg"
 },
 {
  "line": "so they cut each other's.",
  "image": "691682839_1794345503663565.jpg"
 },
 {
  "line": "That perfect haircut",
  "image": "19465445_1794345504623610.jpg"
 },
 {
  "line": "across the street",
  "image": "482970046_1794345505620650.jpg"
 },
 {
  "line": "is the butcher's work,",
  "image": "416357201_1794345506700612.jpg"
 },
 {
  "line": "and the disaster",
  "image": "931603756_1794345507681771.jpg"
 },
 {
  "line": "on the butcher's head",
  "image": "471972376_1794345508627337.jpg"
 },
 {
  "line": "came from the man",
  "image": "304338899_1794345509607332.jpg"
 },
 {
  "line": "yelling \"last chance.\"",
  "image": "665082917_1794345510547268.jpg"
 },
 {
  "line": "By morning,",
  "image": "763239943_1794345511536787.jpg"
 },
 {
  "line": "the line outside the butcher's shop",
  "image": "164055074_1794345512490302.jpg"
 },
 {
  "line": "wraps around the block,",
  "image": "136466957_1794345513576616.jpg"
 },
 {
  "line": "and the other barber",
  "image": "252620019_1794345514546793.jpg"
 },
 {
  "line": "has one way left",
  "image": "996104832_1794345515561457.jpg"
 },
 {
  "line": "to ruin him,",
  "image": "408447463_1794345516531595.jpg"
 },
 {
  "line": "which is",
  "image": "514108784_1794345517372608.jpg"
 },
 {
  "line": "to make him look good.",
  "image": "1073652990_1794345519341562.jpg"
 },
 {
  "line": "So when the butcher comes in",
  "image": "377629411_1794345518390795.jpg"
 },
 {
  "line": "for his usual trim,",
  "image": "882042858_1794345521323497.jpg"
 },
 {
  "line": "he works on it",
  "image": "961952391_1794345520299619.jpg"
 },
 {
  "line": "for three hours,",
  "image": "737127806_1794345523317040.jpg"
 },
 {
  "line": "harder than he has ever worked",
  "image": "281896023_1794345522391063.jpg"
 },
 {
  "line": "in his life.",
  "image": "272324274_1794345525208140.jpg"
 },
 {
  "line": "The butcher walks out",
  "image": "404024941_1794345524247983.jpg"
 },
 {
  "line": "looking worse than ever,",
  "image": "591548844_1794345526080785.jpg"
 },
 {
  "line": "and the line gets longer.",
  "image": "469495728_1794345527039059.jpg"
 }
]