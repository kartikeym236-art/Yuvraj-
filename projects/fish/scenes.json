[
 {
  "line": "In a small pond,",
  "image": "scene_01.jpg"
 },
 {
  "line": "there lived",
  "image": "scene_02.jpg"
 },
 {
  "line": "a hundred fish.",
  "image": "scene_03.jpg"
 },
 {
  "line": "And there was a rule:",
  "image": "scene_04.jpg"
 },
 {
  "line": "do not go",
  "image": "scene_05.jpg"
 },
 {
  "line": "past the rocks.",
  "image": "scene_06.jpg"
 },
 {
  "line": "Whoever goes,",
  "image": "scene_07.jpg"
 },
 {
  "line": "never returns.",
  "image": "scene_08.jpg"
 },
 {
  "line": "A young fish",
  "image": "scene_09.jpg"
 },
 {
  "line": "asked an elder fish,",
  "image": "scene_10.jpg"
 },
 {
  "line": "\"What lies",
  "image": "scene_11.jpg"
 },
 {
  "line": "beyond the rocks?\"",
  "image": "scene_12.jpg"
 },
 {
  "line": "The elder replied,",
  "image": "scene_13.jpg"
 },
 {
  "line": "\"Nothing,",
  "image": "scene_14.jpg"
 },
 {
  "line": "only darkness.\"",
  "image": "scene_15.jpg"
 },
 {
  "line": "So, the young fish",
  "image": "scene_16.jpg"
 },
 {
  "line": "stayed back.",
  "image": "scene_17.jpg"
 },
 {
  "line": "Days passed,",
  "image": "scene_18.jpg"
 },
 {
  "line": "years passed\u2014",
  "image": "scene_19.jpg"
 },
 {
  "line": "the same water,",
  "image": "scene_20.jpg"
 },
 {
  "line": "the same rocks,",
  "image": "scene_21.jpg"
 },
 {
  "line": "the same fear.",
  "image": "scene_22.jpg"
 },
 {
  "line": "Then, one summer,",
  "image": "scene_23.jpg"
 },
 {
  "line": "the pond began",
  "image": "scene_24.jpg"
 },
 {
  "line": "to dry up.",
  "image": "scene_25.jpg"
 },
 {
  "line": "With no other",
  "image": "scene_26.jpg"
 },
 {
  "line": "choice left,",
  "image": "scene_27.jpg"
 },
 {
  "line": "she swam",
  "image": "scene_28.jpg"
 },
 {
  "line": "past the rocks.",
  "image": "scene_29.jpg"
 },
 {
  "line": "And what",
  "image": "scene_30.jpg"
 },
 {
  "line": "did she find there?",
  "image": "scene_31.jpg"
 },
 {
  "line": "A river.",
  "image": "scene_32.jpg"
 },
 {
  "line": "The river flowed",
  "image": "scene_33.jpg"
 },
 {
  "line": "into the sea,",
  "image": "scene_34.jpg"
 },
 {
  "line": "and in the sea,",
  "image": "scene_35.jpg"
 },
 {
  "line": "there were thousands",
  "image": "scene_36.jpg"
 },
 {
  "line": "of fish.",
  "image": "scene_37.jpg"
 },
 {
  "line": "Every single one",
  "image": "scene_38.jpg"
 },
 {
  "line": "had left",
  "image": "scene_39.jpg"
 },
 {
  "line": "a small pond",
  "image": "scene_40.jpg"
 },
 {
  "line": "at some point.",
  "image": "scene_41.jpg"
 },
 {
  "line": "She asked",
  "image": "scene_42.jpg"
 },
 {
  "line": "an elder fish there,",
  "image": "scene_43.jpg"
 },
 {
  "line": "\"Did anyone ever",
  "image": "scene_44.jpg"
 },
 {
  "line": "go back?\"",
  "image": "scene_45.jpg"
 },
 {
  "line": "The elder laughed,",
  "image": "scene_46.jpg"
 },
 {
  "line": "\"Why would anyone",
  "image": "scene_47.jpg"
 },
 {
  "line": "go back?",
  "image": "scene_48.jpg"
 },
 {
  "line": "Water dries up there;",
  "image": "scene_49.jpg"
 },
 {
  "line": "here, it never does.",
  "image": "scene_50.jpg"
 },
 {
  "line": "That is why",
  "image": "scene_51.jpg"
 },
 {
  "line": "no one ever returned\u2014",
  "image": "scene_52.jpg"
 },
 {
  "line": "not because they died,",
  "image": "scene_53.jpg"
 },
 {
  "line": "but because they found",
  "image": "scene_54.jpg"
 },
 {
  "line": "something better.\"",
  "image": "scene_55.jpg"
 },
 {
  "line": "Meanwhile,",
  "image": "scene_56.jpg"
 },
 {
  "line": "back at the pond,",
  "image": "scene_57.jpg"
 },
 {
  "line": "the same old story",
  "image": "scene_58.jpg"
 },
 {
  "line": "continued to be told,",
  "image": "scene_59.jpg"
 },
 {
  "line": "just to keep everyone else",
  "image": "scene_60.jpg"
 },
 {
  "line": "living in fear.",
  "image": "scene_61.jpg"
 },
 {
  "line": "You aren't trapped;",
  "image": "scene_62.jpg"
 },
 {
  "line": "you have simply",
  "image": "scene_63.jpg"
 },
 {
  "line": "been told",
  "image": "scene_64.jpg"
 },
 {
  "line": "that you are.",
  "image": "scene_65.jpg"
 },
 {
  "line": "Those are two",
  "image": "scene_66.jpg"
 },
 {
  "line": "very different things.",
  "image": "scene_67.jpg"
 }
]