[
 {
  "line": "Multiple Russian missiles",
  "image": "2026-11-23T051416.633_266258042_1795410779184487.png"
 },
 {
  "line": "have hit Poland,",
  "image": "2026-11-23T051416.553_769079907_1795410777438549.png"
 },
 {
  "line": "landing just miles",
  "image": "2026-11-23T051416.478_61960256_1795410775706956.png"
 },
 {
  "line": "away from NATO countries'",
  "image": "2026-11-23T051416.403_569803014_1795410774118697.png"
 },
 {
  "line": "military exercises",
  "image": "2026-11-23T051416.302_984483062_1795410772213821.png"
 },
 {
  "line": "rehearsing a possible",
  "image": "2026-11-23T051416.171_466245624_1795410770172164.png"
 },
 {
  "line": "deployment into Ukraine.",
  "image": "2026-11-23T051416.062_635111326_1795410768470455.png"
 },
 {
  "line": "Poland has called it deliberate",
  "image": "2026-11-23T051415.896_410200959_1795410766568491.png"
 },
 {
  "line": "and put its air defenses",
  "image": "2026-11-23T051415.739_622308598_1795410764704278.png"
 },
 {
  "line": "on combat alert.",
  "image": "2026-11-23T051415.606_1039285653_1795410763060955.png"
 },
 {
  "line": "This comes just one",
  "image": "2026-11-23T051415.516_412973225_1795410761304830.png"
 },
 {
  "line": "day after Trump,",
  "image": "2026-11-23T051425.604_file_0000000079bc8211be883f896f20b844.png"
 },
 {
  "line": "Putin, and Xi",
  "image": "2026-11-23T051425.286_file_00000000c4f48211b61dbe6b159550eb.png"
 },
 {
  "line": "issued their world peace",
  "image": "2026-11-23T051425.017_file_0000000096488211a5e537c93ef7be4d.png"
 },
 {
  "line": "declaration,",
  "image": "2026-11-23T051415.385_212372378_1795410759565796.png"
 },
 {
  "line": "pledging to maintain",
  "image": "2026-11-23T051422.860_file_0000000013c88211a1f7f7724353db3d.png"
 },
 {
  "line": "international security.",
  "image": "2026-11-23T051415.166_841818422_1795410757591373.png"
 },
 {
  "line": "Meanwhile in America,",
  "image": "2026-11-23T051414.873_970465199_1795410756037428.png"
 },
 {
  "line": "a cyberattack has",
  "image": "2026-11-23T051414.732_877170415_1795410754273722.png"
 },
 {
  "line": "reportedly breached the",
  "image": "2026-11-23T051414.579_327947168_1795410752280242.png"
 },
 {
  "line": "Department of Agriculture,",
  "image": "2026-11-23T051414.373_453913815_1795410750430182.png"
 },
 {
  "line": "which protects the nation's",
  "image": "2026-11-23T051414.220_589875492_1795410748857734.png"
 },
 {
  "line": "food supply.",
  "image": "2026-11-23T051414.012_915576934_1795410746543910.png"
 },
 {
  "line": "The same week,",
  "image": "2026-11-23T051413.663_570325062_1795410744481081.png"
 },
 {
  "line": "Homeland Security warned",
  "image": "2026-11-23T051413.286_455170720_1795410742685268.png"
 },
 {
  "line": "the country's critical infrastructure",
  "image": "2026-11-23T051419.493_493247657_1795410740636957.png"
 },
 {
  "line": "was under attack.",
  "image": "2026-11-23T051419.317_874785393_1795410738237865.png"
 },
 {
  "line": "Across the Atlantic,",
  "image": "2026-11-23T051419.060_363689588_1795410735845992.png"
 },
 {
  "line": "Britain's top cyber",
  "image": "2026-11-23T051418.911_433507209_1795410733095646.png"
 },
 {
  "line": "commander has confirmed",
  "image": "2026-11-23T051418.767_1055058221_1795410728391394.png"
 },
 {
  "line": "they are conducting offensive",
  "image": "2026-11-23T051418.605_80837977_1795410721950940.png"
 },
 {
  "line": "cyberattacks against",
  "image": "2026-11-23T051418.487_615752814_1795410716323055.png"
 },
 {
  "line": "Russia, China,",
  "image": "2026-11-23T051418.369_714201649_1795410713473676.png"
 },
 {
  "line": "Iran,",
  "image": "2026-11-23T051418.275_103956377_1795410709590445.png"
 },
 {
  "line": "and North Korea,",
  "image": "2026-11-23T051418.189_819785513_1795410706818260.png"
 },
 {
  "line": "warning, \"We're not",
  "image": "2026-11-23T051418.092_910690726_1795410698741745.png"
 },
 {
  "line": "at war, but we're not",
  "image": "2026-11-23T051417.983_20818478_1795410696037756.png"
 },
 {
  "line": "at peace either.\"",
  "image": "2026-11-23T051417.880_258818200_1795410693772951.png"
 },
 {
  "line": "Over in Denmark,",
  "image": "2026-11-23T051417.790_865246281_1795410691222380.png"
 },
 {
  "line": "the government has expelled",
  "image": "2026-11-23T051417.720_757455686_1795410689354567.png"
 },
 {
  "line": "a Russian military diplomat,",
  "image": "2026-11-23T051417.628_689385168_1795410686554487.png"
 },
 {
  "line": "accusing Moscow",
  "image": "2026-11-23T051417.539_378733144_1795410683392028.png"
 },
 {
  "line": "of plotting to assassinate",
  "image": "2026-11-23T051417.458_263786993_1795410681615966.png"
 },
 {
  "line": "an American Ukrainian",
  "image": "2026-11-23T051417.369_706768929_1795410679464262.png"
 },
 {
  "line": "rapper on Danish",
  "image": "2026-11-23T051417.283_714106428_1795410677086405.png"
 },
 {
  "line": "soil. Further",
  "image": "2026-11-23T051417.192_186129997_1795410674242227.png"
 },
 {
  "line": "east, Estonia",
  "image": "2026-11-23T051417.113_305444140_1795410671878296.png"
 },
 {
  "line": "is closing every border",
  "image": "2026-11-23T051417.011_609861611_1795410668276841.png"
 },
 {
  "line": "crossing with Russia.",
  "image": "2026-11-23T051416.943_668975542_1795410666363828.png"
 },
 {
  "line": "In Ukraine,",
  "image": "2026-11-23T051416.877_771063825_1795410663854256.png"
 },
 {
  "line": "Putin's promised revenge",
  "image": "2026-11-23T051422.752_file_000000005cc882119884f831e6ceaf97.png"
 },
 {
  "line": "has arrived,",
  "image": "2026-11-23T051416.780_749385901_1795410660836540.png"
 },
 {
  "line": "with one of the war's largest",
  "image": "2026-11-23T051416.711_615855151_1795410658607726.png"
 },
 {
  "line": "attacks striking",
  "image": "2026-11-23T051422.291_425721593_1795410656318324.png"
 },
 {
  "line": "three of Kyiv's main",
  "image": "2026-11-23T051422.171_948410207_1795410653741546.png"
 },
 {
  "line": "bridges and killing",
  "image": "2026-11-23T051422.067_859561667_1795410651928829.png"
 },
 {
  "line": "at least nine civilians.",
  "image": "2026-11-23T051421.914_436810871_1795410649798776.png"
 },
 {
  "line": "Moscow is warning",
  "image": "2026-11-23T051421.723_428587374_1795410647814728.png"
 },
 {
  "line": "foreign embassies to leave",
  "image": "2026-11-23T051421.615_998492017_1795410646100878.png"
 },
 {
  "line": "Kyiv, as Putin",
  "image": "2026-11-23T051421.491_934727106_1795410643353688.png"
 },
 {
  "line": "publicly urges Ukrainian",
  "image": "2026-11-23T051422.610_file_0000000058988211a3575177c8a7def2.png"
 },
 {
  "line": "soldiers to come over",
  "image": "2026-11-23T051421.362_1008071067_1795410641476802.png"
 },
 {
  "line": "and join Russia's side,",
  "image": "2026-11-23T051421.214_315787095_1795410639161921.png"
 },
 {
  "line": "or what he calls",
  "image": "2026-11-23T051422.450_file_000000004de08211b890552597e03180.png"
 },
 {
  "line": "\"the right side of history.\"",
  "image": "2026-11-23T051421.038_69759340_1795410636930697.png"
 },
 {
  "line": "Further south in the Gulf,",
  "image": "2026-11-23T051420.840_986551156_1795410633765134.png"
 },
 {
  "line": "Israel and America",
  "image": "2026-11-23T051420.672_926947410_1795410630918989.png"
 },
 {
  "line": "are planning for a new",
  "image": "2026-11-23T051420.543_5913432_1795410628637235.png"
 },
 {
  "line": "assault on Iran,",
  "image": "2026-11-23T051420.346_247264932_1795410625741342.png"
 },
 {
  "line": "as Israel's ambassador",
  "image": "2026-11-23T051420.142_688167629_1795410623571428.png"
 },
 {
  "line": "says American troops",
  "image": "2026-11-23T051420.004_215976073_1795410621207722.png"
 },
 {
  "line": "will not come home",
  "image": "2026-11-23T051419.842_649897466_1795410618487616.png"
 },
 {
  "line": "until Iran is defeated.",
  "image": "2026-11-23T051419.703_572837000_1795410615684436.png"
 }
]