[
 {
  "line": "How many countries has",
  "image": "2026-11-27T073352.515_643152632_1795764703980440.png"
 },
 {
  "line": "Israel actually struck?",
  "image": "2026-11-27T073352.731_571594006_1795764705774467.png"
 },
 {
  "line": "Not threatened.",
  "image": "2026-11-27T073352.984_925497670_1795764707459507.png"
 },
 {
  "line": "Struck. The",
  "image": "2026-11-27T073353.082_716056679_1795764709062538.png"
 },
 {
  "line": "real list is longer",
  "image": "2026-11-27T073353.149_153123593_1795764710771333.png"
 },
 {
  "line": "than most people think.",
  "image": "2026-11-27T073353.230_739217657_1795764712597063.png"
 },
 {
  "line": "Start with the obvious",
  "image": "2026-11-27T073353.303_781397353_1795764714135071.png"
 },
 {
  "line": "ones. Gaza",
  "image": "2026-11-27T073353.412_642184578_1795764715910731.png"
 },
 {
  "line": "and the West Bank.",
  "image": "2026-11-27T073353.531_555656714_1795764717674854.png"
 },
 {
  "line": "Lebanon, where it has fought",
  "image": "2026-11-27T073353.588_333982520_1795764719526747.png"
 },
 {
  "line": "Hezbollah for decades.",
  "image": "2026-11-27T073353.727_93880168_1795764721254294.png"
 },
 {
  "line": "Syria, where",
  "image": "2026-11-27T073353.782_76731662_1795764722974199.png"
 },
 {
  "line": "it has hit targets hundreds",
  "image": "2026-11-27T073353.830_758632096_1795764724868264.png"
 },
 {
  "line": "of times. Iran,",
  "image": "2026-11-27T073353.891_913753224_1795764726374187.png"
 },
 {
  "line": "where it struck nuclear",
  "image": "2026-11-27T073353.950_689122853_1795764728324020.png"
 },
 {
  "line": "and military sites.",
  "image": "2026-11-27T073354.015_385869180_1795764730143251.png"
 },
 {
  "line": "Iraq, where in {1981|nineteen eighty one}",
  "image": "2026-11-27T073354.088_809819083_1795764732067701.png"
 },
 {
  "line": "its jets destroyed",
  "image": "2026-11-27T073354.162_41708053_1795764734004762.png"
 },
 {
  "line": "a nuclear reactor.",
  "image": "2026-11-27T073354.226_937837193_1795764735778813.png"
 },
 {
  "line": "And Yemen,",
  "image": "2026-11-27T073354.287_460176459_1795764737549018.png"
 },
 {
  "line": "where it has bombed Houthi",
  "image": "2026-11-27T073354.353_1016419500_1795764739296940.png"
 },
 {
  "line": "ports and power stations.",
  "image": "2026-11-27T073354.422_494816353_1795764740952463.png"
 },
 {
  "line": "Then it gets surprising.",
  "image": "2026-11-27T073354.479_596119466_1795764742854608.png"
 },
 {
  "line": "Qatar,",
  "image": "2026-11-27T073354.539_264767581_1795764744391810.png"
 },
 {
  "line": "where in {2025|twenty twenty five}",
  "image": "2026-11-27T073354.590_183616775_1795764745752896.png"
 },
 {
  "line": "Israel struck Hamas",
  "image": "2026-11-27T073354.655_781887758_1795764747165520.png"
 },
 {
  "line": "leaders in Doha,",
  "image": "2026-11-27T073354.715_68839898_1795764748974193.png"
 },
 {
  "line": "inside a close American",
  "image": "2026-11-27T073354.796_914549401_1795764750675988.png"
 },
 {
  "line": "ally. Sudan,",
  "image": "2026-11-27T073354.862_622047321_1795764752576813.png"
 },
 {
  "line": "where it reportedly hit",
  "image": "2026-11-27T073354.946_19972019_1795764754281649.png"
 },
 {
  "line": "weapons convoys",
  "image": "2026-11-27T073355.013_805107183_1795764756270698.png"
 },
 {
  "line": "heading to Gaza.",
  "image": "2026-11-27T073355.064_71560475_1795764757901212.png"
 },
 {
  "line": "Tunisia,",
  "image": "2026-11-27T073355.115_258434475_1795764759605075.png"
 },
 {
  "line": "where in {1985|nineteen eighty five}",
  "image": "2026-11-27T073355.171_118941667_1795764761465760.png"
 },
 {
  "line": "it bombed the headquarters",
  "image": "2026-11-27T073355.237_738656924_1795764763284459.png"
 },
 {
  "line": "of the Palestine Liberation",
  "image": "2026-11-27T073355.312_785165426_1795764765213130.png"
 },
 {
  "line": "Organization,",
  "image": "2026-11-27T073355.374_296587431_1795764766656848.png"
 },
 {
  "line": "more than a thousand miles",
  "image": "2026-11-27T073355.440_863503354_1795764767881907.png"
 },
 {
  "line": "from home. Uganda,",
  "image": "2026-11-27T073355.505_580632657_1795764769544023.png"
 },
 {
  "line": "where in {1976|nineteen seventy six}",
  "image": "2026-11-27T073355.575_967085451_1795764771185311.png"
 },
 {
  "line": "Israeli commandos",
  "image": "2026-11-27T073355.619_145581045_1795764772993231.png"
 },
 {
  "line": "flew thousands of miles",
  "image": "2026-11-27T073355.660_267958479_1795764774691762.png"
 },
 {
  "line": "to Entebbe airport",
  "image": "2026-11-27T073355.874_1023499254_1795764778110147.png"
 },
 {
  "line": "and rescued over",
  "image": "2026-11-27T073355.740_1043624159_1795764776553044.png"
 },
 {
  "line": "a hundred hostages",
  "image": "2026-11-27T073355.929_578055540_1795764780069554.png"
 },
 {
  "line": "in ninety minutes.",
  "image": "2026-11-27T073356.005_333831864_1795764781846322.png"
 },
 {
  "line": "And Egypt and Jordan,",
  "image": "2026-11-27T073356.082_379278686_1795764784187092.png"
 },
 {
  "line": "where it fought full scale",
  "image": "2026-11-27T073356.152_920882154_1795764786025133.png"
 },
 {
  "line": "wars before signing",
  "image": "2026-11-27T073356.219_995519796_1795764787798114.png"
 },
 {
  "line": "peace deals.",
  "image": "2026-11-27T073356.273_844838220_1795764789960945.png"
 },
 {
  "line": "And that's just the open",
  "image": "2026-11-27T073357.431_956239016_1795764791929778.png"
 },
 {
  "line": "strikes. Israeli",
  "image": "2026-11-27T073357.512_197176931_1795764793491768.png"
 },
 {
  "line": "intelligence has been",
  "image": "2026-11-27T073357.572_827495760_1795764795162607.png"
 },
 {
  "line": "linked to covert operations",
  "image": "2026-11-27T073357.617_559353180_1795764797115109.png"
 },
 {
  "line": "across Europe,",
  "image": "2026-11-27T073357.681_692555733_1795764798879584.png"
 },
 {
  "line": "Dubai and beyond.",
  "image": "2026-11-27T073357.882_548551596_1795764808488254.png"
 },
 {
  "line": "That's more than a dozen",
  "image": "2026-11-27T073357.764_440471690_1795764805168834.png"
 },
 {
  "line": "countries across the Middle",
  "image": "2026-11-27T073357.824_981111984_1795764806955175.png"
 },
 {
  "line": "East and Africa.",
  "image": "2026-11-27T073357.946_287065675_1795764809942073.png"
 },
 {
  "line": "Supporters call it self",
  "image": "2026-11-27T073358.669_151121814_1795764814734504.png"
 },
 {
  "line": "defense against enemies",
  "image": "2026-11-27T073358.604_439899573_1795764813215105.png"
 },
 {
  "line": "who want Israel gone.",
  "image": "2026-11-27T073358.020_789903365_1795764811682470.png"
 },
 {
  "line": "Critics call it a regional",
  "image": "2026-11-27T073358.808_916146601_1795764817811519.png"
 },
 {
  "line": "war that never stops",
  "image": "2026-11-27T073358.729_96976805_1795764816251246.png"
 },
 {
  "line": "expanding.",
  "image": "2026-11-27T073358.894_150298782_1795764819747072.png"
 },
 {
  "line": "So which is it?",
  "image": "2026-11-27T073358.956_296245480_1795764821574088.png"
 },
 {
  "line": "Tell me in the comments,",
  "image": "2026-11-27T073359.033_142691008_1795764822910873.png"
 },
 {
  "line": "and follow for more.",
  "image": "2026-11-27T073359.088_396029474_1795764824596647.png"
 }
]