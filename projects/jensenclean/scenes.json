[
 {
  "line": "Jensen Huang is back.",
  "image": "2026-11-23T194601.571_782834468_1795457775253306.png"
 },
 {
  "line": "Nvidia's board has",
  "image": "2026-11-23T194601.277_876549499_1795457776130612.png"
 },
 {
  "line": "made him CEO again.",
  "image": "2026-11-23T194601.888_542607553_1795457774165663.png"
 },
 {
  "line": "Remember our video",
  "image": "2026-11-23T200008.972_file_00000000a9dc8211b30f3fb2525f8f21.png"
 },
 {
  "line": "a few days ago saying",
  "image": "2026-11-23T194602.002_470899606_1795457773349981.png"
 },
 {
  "line": "he would return?",
  "image": "2026-11-23T200008.886_file_00000000d4208211917ff78667a52154.png"
 },
 {
  "line": "People said it was fake,",
  "image": "2026-11-23T194602.120_627478501_1795457772552170.png"
 },
 {
  "line": "that it would never happen.",
  "image": "2026-11-23T194602.240_241142240_1795457771691249.png"
 },
 {
  "line": "This video is for you.",
  "image": "2026-11-23T194602.367_935459954_1795457770731358.png"
 },
 {
  "line": "First, understand",
  "image": "2026-11-23T194602.467_358330427_1795457769982783.png"
 },
 {
  "line": "the game. Just",
  "image": "2026-11-23T194602.562_743799748_1795457769029552.png"
 },
 {
  "line": "days ago,",
  "image": "2026-11-23T194602.629_428952234_1795457767954843.png"
 },
 {
  "line": "this same board clearly",
  "image": "2026-11-23T194602.737_15257371_1795457765823640.png"
 },
 {
  "line": "said, we will",
  "image": "2026-11-23T194602.818_845622369_1795457764931802.png"
 },
 {
  "line": "never take Jensen",
  "image": "2026-11-23T194602.913_45080442_1795457764074661.png"
 },
 {
  "line": "Huang back.",
  "image": "2026-11-23T194603.025_212587667_1795457763024302.png"
 },
 {
  "line": "And today,",
  "image": "2026-11-23T194603.118_389995555_1795457762019705.png"
 },
 {
  "line": "the same board voted",
  "image": "2026-11-23T194603.190_931133365_1795457761011524.png"
 },
 {
  "line": "unanimously and made",
  "image": "2026-11-23T194603.268_27804899_1795457759825474.png"
 },
 {
  "line": "him CEO and president",
  "image": "2026-11-23T194603.334_191382806_1795457758645856.png"
 },
 {
  "line": "again. So what",
  "image": "2026-11-23T200008.795_file_000000006a688211bedc2a5adcbfdeaa.png"
 },
 {
  "line": "changed? Money",
  "image": "2026-11-23T200008.691_file_00000000c7dc8211a38a081d68ac8c5a.png"
 },
 {
  "line": "talks, my friend.",
  "image": "2026-11-23T200008.577_file_0000000012208211b1cf8b4fa938ab50.png"
 },
 {
  "line": "After Jensen left,",
  "image": "2026-11-23T200008.479_file_0000000045f8821199ad0d3426b2a425.png"
 },
 {
  "line": "Nvidia's stock fell",
  "image": "2026-11-23T194635.623_1011567046_1795457706603762.png"
 },
 {
  "line": "almost {23%|twenty three percent}",
  "image": "2026-11-23T194603.415_1050537917_1795457757830279.png"
 },
 {
  "line": "in one week.",
  "image": "2026-11-23T194603.503_546768111_1795457756899049.png"
 },
 {
  "line": "Its worst week since",
  "image": "2026-11-23T194603.592_394228220_1795457755781561.png"
 },
 {
  "line": "{2008|two thousand eight}.",
  "image": "2026-11-23T194603.688_792819775_1795457754989051.png"
 },
 {
  "line": "From the October peak,",
  "image": "2026-11-23T194603.768_928972692_1795457753966553.png"
 },
 {
  "line": "almost {$2.7 trillion|two point seven trillion dollars}",
  "image": "2026-11-23T194603.884_863237587_1795457753017935.png"
 },
 {
  "line": "got wiped out.",
  "image": "2026-11-23T194603.980_1030091187_1795457752278039.png"
 },
 {
  "line": "Almost half the company's",
  "image": "2026-11-23T194604.079_346611860_1795457751400363.png"
 },
 {
  "line": "value,",
  "image": "2026-11-23T194604.167_668454815_1795457750247839.png"
 },
 {
  "line": "gone. Then the pressure",
  "image": "2026-11-23T194604.250_909897325_1795457749457433.png"
 },
 {
  "line": "came. A petition",
  "image": "2026-11-23T194604.336_504901819_1795457748291023.png"
 },
 {
  "line": "signed by more than two",
  "image": "2026-11-23T194604.439_187478924_1795457747354051.png"
 },
 {
  "line": "hundred thousand people.",
  "image": "2026-11-23T194604.540_261198208_1795457746151369.png"
 },
 {
  "line": "Elon Musk said it",
  "image": "2026-11-23T194604.631_503576256_1795457745088678.png"
 },
 {
  "line": "would be his honor to hire",
  "image": "2026-11-23T194604.740_1016572860_1795457743169409.png"
 },
 {
  "line": "Jensen Huang.",
  "image": "2026-11-23T194604.835_262001719_1795457742333911.png"
 },
 {
  "line": "And Trump himself posted",
  "image": "2026-11-23T194604.940_378990180_1795457741227440.png"
 },
 {
  "line": "that the board should bring him",
  "image": "2026-11-23T200008.347_file_0000000030008211988ae96dbb7102f8.png"
 },
 {
  "line": "back, that it would",
  "image": "2026-11-23T194633.535_338027473_1795457740474231.png"
 },
 {
  "line": "be best for the company",
  "image": "2026-11-23T200008.224_file_0000000025908211a1fbafa46dfe7ad7.png"
 },
 {
  "line": "and for America.",
  "image": "2026-11-23T200008.118_file_000000008cf08211a452292784373eff.png"
 },
 {
  "line": "The very next day,",
  "image": "2026-11-23T194633.631_360761043_1795457739703584.png"
 },
 {
  "line": "Jensen was back.",
  "image": "2026-11-23T194633.746_446030192_1795457738926881.png"
 },
 {
  "line": "And the spy matter?",
  "image": "2026-11-23T194633.856_444373788_1795457738102719.png"
 },
 {
  "line": "The board says it took",
  "image": "2026-11-23T200008.022_file_0000000044548211a5ad33c68ca7531b.png"
 },
 {
  "line": "input from senior",
  "image": "2026-11-23T200007.873_file_00000000e5f8821192d775e049285df8.png"
 },
 {
  "line": "people in the {US|u s}",
  "image": "2026-11-23T200007.765_file_000000005e8c82119a8c47be742c4b1b.png"
 },
 {
  "line": "government, and",
  "image": "2026-11-23T200007.683_file_0000000050a8821199f2f08d22817042.png"
 },
 {
  "line": "with Jensen back,",
  "image": "2026-11-23T194633.972_604518357_1795457737286902.png"
 },
 {
  "line": "there is no national",
  "image": "2026-11-23T194634.071_1022882481_1795457736346660.png"
 },
 {
  "line": "security risk.",
  "image": "2026-11-23T194634.191_40774918_1795457734505462.png"
 },
 {
  "line": "The investigation is",
  "image": "2026-11-23T194634.304_222737724_1795457732676308.png"
 },
 {
  "line": "still open,",
  "image": "2026-11-23T194634.403_412715642_1795457730945822.png"
 },
 {
  "line": "and it will run its course.",
  "image": "2026-11-23T194634.523_1033776815_1795457728973691.png"
 },
 {
  "line": "But remember what we",
  "image": "2026-11-23T194634.632_9430558_1795457727162884.png"
 },
 {
  "line": "said. This",
  "image": "2026-11-23T200007.592_file_00000000d9e0821181842043e45181ac.png"
 },
 {
  "line": "was never just Nvidia's",
  "image": "2026-11-23T200007.498_file_000000009b188211bf1721fe9d5da1c9.png"
 },
 {
  "line": "loss. Nvidia's",
  "image": "2026-11-23T200007.392_file_00000000feac82118033ae21c05c5a9a.png"
 },
 {
  "line": "chips power the entire",
  "image": "2026-11-23T200007.303_file_000000000f388211a797586fc97738f8.png"
 },
 {
  "line": "{AI|a i} industry,",
  "image": "2026-11-23T200007.185_file_00000000ec04821185f628052717cfad.png"
 },
 {
  "line": "the industry the American",
  "image": "2026-11-23T194634.756_992617092_1795457725047512.png"
 },
 {
  "line": "economy is standing",
  "image": "2026-11-23T200007.006_file_0000000015f88211a37c34cdd252fe46.png"
 },
 {
  "line": "on right now.",
  "image": "2026-11-23T194635.059_355287878_1795457719271447.png"
 },
 {
  "line": "When Nvidia shakes,",
  "image": "2026-11-23T200006.465_file_000000001a3c8211960e0a3a6f264a4d.png"
 },
 {
  "line": "all of it shakes.",
  "image": "2026-11-23T200006.248_file_0000000064588211a7cbe0c21974fb96.png"
 },
 {
  "line": "So the result?",
  "image": "2026-11-23T194635.144_832209487_1795457717217723.png"
 },
 {
  "line": "The moment the news broke,",
  "image": "2026-11-23T194635.232_377484737_1795457715567853.png"
 },
 {
  "line": "the stock jumped more",
  "image": "2026-11-23T194635.300_397732375_1795457713717335.png"
 },
 {
  "line": "than {25%|twenty five percent}.",
  "image": "2026-11-23T194635.399_660535755_1795457711969936.png"
 },
 {
  "line": "But here's the part nobody",
  "image": "2026-11-23T194635.465_713338462_1795457710050132.png"
 },
 {
  "line": "tells you. On",
  "image": "2026-11-23T194635.541_1069801473_1795457708178440.png"
 },
 {
  "line": "the very day Jensen",
  "image": "2026-11-23T200006.039_file_000000004d808211a9c93817425fa8c7.png"
 },
 {
  "line": "resigned, according",
  "image": "2026-11-23T194635.685_689485254_1795457702701155.png"
 },
 {
  "line": "to a Reuters report,",
  "image": "2026-11-23T194635.766_396083152_1795457700986022.png"
 },
 {
  "line": "big options traders",
  "image": "2026-11-23T194635.860_681630511_1795457699073264.png"
 },
 {
  "line": "were already building positions",
  "image": "2026-11-23T194635.962_1055800943_1795457697110211.png"
 },
 {
  "line": "for a recovery.",
  "image": "2026-11-23T194636.051_419936156_1795457695422879.png"
 },
 {
  "line": "One trader opened a bullish",
  "image": "2026-11-23T194636.170_1025901934_1795457693988920.png"
 },
 {
  "line": "bet worth more than",
  "image": "2026-11-23T194636.289_343705595_1795457691973432.png"
 },
 {
  "line": "{$100 million|one hundred million dollars}.",
  "image": "2026-11-23T194636.379_526861519_1795457690051284.png"
 },
 {
  "line": "So while the common man",
  "image": "2026-11-23T194636.493_123863419_1795457688140186.png"
 },
 {
  "line": "was panicking and selling,",
  "image": "2026-11-23T194636.584_617913408_1795457686223342.png"
 },
 {
  "line": "big players were quietly",
  "image": "2026-11-23T194636.701_220778464_1795457684257874.png"
 },
 {
  "line": "buying. There's",
  "image": "2026-11-23T194636.844_357905458_1795457682419014.png"
 },
 {
  "line": "no proof of insider",
  "image": "2026-11-23T194636.943_737307111_1795457680357905.png"
 },
 {
  "line": "trading. But",
  "image": "2026-11-23T194637.067_1032223715_1795457678606068.png"
 },
 {
  "line": "you know the pattern.",
  "image": "2026-11-23T194637.185_23415499_1795457677085754.png"
 },
 {
  "line": "Create panic,",
  "image": "2026-11-23T194637.290_909247734_1795457675343381.png"
 },
 {
  "line": "the small investor exits,",
  "image": "2026-11-23T194637.433_483924537_1795457673799662.png"
 },
 {
  "line": "and the big money buys",
  "image": "2026-11-23T194637.568_8235652_1795457671833568.png"
 },
 {
  "line": "cheap. Now look at this",
  "image": "2026-11-23T194637.676_966751418_1795457669801555.png"
 },
 {
  "line": "man. He was",
  "image": "2026-11-23T194637.779_646141216_1795457668131803.png"
 },
 {
  "line": "once a dishwasher",
  "image": "2026-11-23T194637.897_735840650_1795457666517352.png"
 },
 {
  "line": "at a Denny's restaurant.",
  "image": "2026-11-23T194640.204_1029591521_1795457665080439.png"
 },
 {
  "line": "In {33|thirty three} years,",
  "image": "2026-11-23T194640.425_868536126_1795457663013017.png"
 },
 {
  "line": "he built one of the most valuable",
  "image": "2026-11-23T194640.563_813284732_1795457660783877.png"
 },
 {
  "line": "companies in the world.",
  "image": "2026-11-23T194640.693_933866224_1795457658146607.png"
 },
 {
  "line": "And he was out for just",
  "image": "2026-11-23T194640.778_10031197_1795457656042718.png"
 },
 {
  "line": "days before taking",
  "image": "2026-11-23T194640.898_706146450_1795457654022996.png"
 },
 {
  "line": "back the CEO's chair.",
  "image": "2026-11-23T194641.035_957543214_1795457652091171.png"
 },
 {
  "line": "Salute. This",
  "image": "2026-11-23T194641.134_690481265_1795457650180175.png"
 },
 {
  "line": "guy is a legend.",
  "image": "2026-11-23T194641.256_804616836_1795457646240947.png"
 },
 {
  "line": "So what do you think?",
  "image": "2026-11-23T194641.347_930605468_1795457641575026.png"
 },
 {
  "line": "Did the board feel the pressure,",
  "image": "2026-11-23T194641.435_1009288744_1795457636073083.png"
 },
 {
  "line": "or did it bow down?",
  "image": "2026-11-23T194641.533_1020769353_1795457634289828.png"
 },
 {
  "line": "Tell me in the comments.",
  "image": "2026-11-23T194641.667_1070179487_1795457632469456.png"
 },
 {
  "line": "Like, share,",
  "image": "2026-11-23T194641.981_912583424_1795457626880608.png"
 },
 {
  "line": "and follow for more.",
  "image": "2026-11-23T194642.077_828349805_1795457625112012.png"
 }
]