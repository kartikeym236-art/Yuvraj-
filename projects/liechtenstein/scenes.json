[
 {
  "line": "There is also a country",
  "image": "144536.073_file_0000000031448211b39f945f88137aec.png"
 },
 {
  "line": "in the world that you can literally",
  "image": "144533.663_280575683_1795358430281144.png"
 },
 {
  "line": "rent for a day,",
  "image": "144533.844_605253124_1795358432119143.png"
 },
 {
  "line": "and along with that,",
  "image": "144534.058_264766565_1795358433899687.png"
 },
 {
  "line": "you even get the key",
  "image": "144534.252_345422923_1795358435847260.png"
 },
 {
  "line": "to the entire country?",
  "image": "144534.437_444802751_1795358437680923.png"
 },
 {
  "line": "This country is nestled",
  "image": "144534.598_491213897_1795358439916358.png"
 },
 {
  "line": "between Switzerland and",
  "image": "144534.759_168237546_1795358442267841.png"
 },
 {
  "line": "Austria. It",
  "image": "144534.888_231307185_1795358444071350.png"
 },
 {
  "line": "is one of the smallest countries",
  "image": "144535.075_14619031_1795358446142848.png"
 },
 {
  "line": "in the world, and",
  "image": "144535.254_905514034_1795358448265715.png"
 },
 {
  "line": "for around {$70,000|seventy thousand dollars}",
  "image": "144535.552_648394792_1795358452017940.png"
 },
 {
  "line": "per night, you can literally",
  "image": "144535.682_928134456_1795358453667479.png"
 },
 {
  "line": "rent this entire country.",
  "image": "144535.798_848585432_1795358455633267.png"
 },
 {
  "line": "With this, you get temporary",
  "image": "144535.936_1048831768_1795358457496186.png"
 },
 {
  "line": "control of street signs,",
  "image": "144529.609_292821668_1795358459734631.png"
 },
 {
  "line": "custom currency printed",
  "image": "144529.779_20756330_1795358461581057.png"
 },
 {
  "line": "for the special occasion,",
  "image": "144530.005_261135727_1795358463909372.png"
 },
 {
  "line": "and a ceremonial key",
  "image": "144530.198_909624378_1795358465615915.png"
 },
 {
  "line": "given by the government.",
  "image": "144530.331_499902438_1795358467918634.png"
 },
 {
  "line": "But this is just the beginning",
  "image": "144530.586_170546912_1795358470161609.png"
 },
 {
  "line": "of what makes this place",
  "image": "144530.783_320724636_1795358472114805.png"
 },
 {
  "line": "so unique.",
  "image": "144530.902_1054695153_1795358473837177.png"
 },
 {
  "line": "There is no military",
  "image": "144531.064_468400509_1795358475516136.png"
 },
 {
  "line": "here, no airport,",
  "image": "144531.218_1044879192_1795358477825173.png"
 },
 {
  "line": "and the crime rate is so",
  "image": "144531.535_296518865_1795358479848284.png"
 },
 {
  "line": "rare that people",
  "image": "144531.718_1000523003_1795358481695989.png"
 },
 {
  "line": "leave their house doors unlocked.",
  "image": "144531.877_843697842_1795358483575493.png"
 },
 {
  "line": "The last time their army",
  "image": "144532.047_151676284_1795358486098180.png"
 },
 {
  "line": "went to war was",
  "image": "144532.201_107966502_1795358488088262.png"
 },
 {
  "line": "in {1866|eighteen sixty six}.",
  "image": "144532.363_275092556_1795358489922163.png"
 },
 {
  "line": "They sent {80|eighty} soldiers",
  "image": "144532.576_891181379_1795358491827011.png"
 },
 {
  "line": "and {81|eighty one} returned,",
  "image": "144532.761_986178456_1795358498803067.png"
 },
 {
  "line": "because on the way back,",
  "image": "144532.905_1015388392_1795358500850887.png"
 },
 {
  "line": "they made a friend along",
  "image": "144533.079_898026193_1795358502740164.png"
 },
 {
  "line": "the route. In",
  "image": "144533.364_846782401_1795358504544674.png"
 },
 {
  "line": "per capita income,",
  "image": "144533.527_959814604_1795358506569652.png"
 },
 {
  "line": "this country is one of",
  "image": "144527.805_934537583_1795358508418092.png"
 },
 {
  "line": "the richest countries in",
  "image": "144527.893_754223093_1795358510650958.png"
 },
 {
  "line": "the world, and",
  "image": "144528.001_927325874_1795358512887960.png"
 },
 {
  "line": "here there are actually more",
  "image": "144528.134_733359245_1795358515035196.png"
 },
 {
  "line": "registered companies than",
  "image": "144528.246_706254055_1795358518148461.png"
 },
 {
  "line": "people. And",
  "image": "144528.388_19236305_1795358520633003.png"
 },
 {
  "line": "the royal family that runs",
  "image": "144528.491_352888916_1795358522628696.png"
 },
 {
  "line": "this country is",
  "image": "144528.610_170407870_1795358525512828.png"
 },
 {
  "line": "even richer than the British",
  "image": "144528.706_79873333_1795358528061643.png"
 },
 {
  "line": "royal family.",
  "image": "144528.821_367808128_1795358530290974.png"
 },
 {
  "line": "The prince here still",
  "image": "144528.959_676957537_1795358532080505.png"
 },
 {
  "line": "lives in a real castle",
  "image": "144529.058_671178965_1795358534109512.png"
 },
 {
  "line": "built on a mountain right",
  "image": "144529.177_350186510_1795358535819647.png"
 },
 {
  "line": "above the capital,",
  "image": "144529.296_212172871_1795358538544144.png"
 },
 {
  "line": "and he has more real powers",
  "image": "144529.481_1062005394_1795358540667195.png"
 },
 {
  "line": "than any other monarch",
  "image": "144527.549_702815706_1795358542804777.png"
 },
 {
  "line": "in Europe. This",
  "image": "144526.594_27437669_1795358546986728.png"
 },
 {
  "line": "country is so small",
  "image": "144527.662_49843331_1795358544884075.png"
 },
 {
  "line": "that you can walk across",
  "image": "144526.874_993668941_1795358550830710.png"
 },
 {
  "line": "the whole thing in just",
  "image": "144526.747_279938394_1795358548964118.png"
 },
 {
  "line": "a few hours.",
  "image": "144527.181_955737108_1795358555253485.png"
 },
 {
  "line": "Yet, the people here",
  "image": "144527.011_889815998_1795358553259463.png"
 },
 {
  "line": "enjoy some of the highest",
  "image": "144527.414_845406660_1795358559985673.png"
 },
 {
  "line": "standards of living in the world.",
  "image": "144527.312_730325523_1795358557595051.png"
 },
 {
  "line": "The name of this country",
  "image": "144525.896_70049690_1795358561777078.png"
 },
 {
  "line": "is Liechtenstein.",
  "image": "144526.051_53185738_1795358563983381.png"
 }
]