[
 {
  "line": "Even the man set to",
  "image": "2026-11-24T193221.297_80343538_1795548632629687.png"
 },
 {
  "line": "become the world's first",
  "image": "2026-11-24T193221.989_838864500_1795548634296666.png"
 },
 {
  "line": "trillionaire bows to",
  "image": "2026-11-24T193222.596_515907652_1795548635893128.png"
 },
 {
  "line": "the sheikhs of Dubai.",
  "image": "2026-11-24T193222.774_958673387_1795548637504879.png"
 },
 {
  "line": "And here's the surprising",
  "image": "2026-11-24T193223.030_428778833_1795548639118323.png"
 },
 {
  "line": "part. You'll probably",
  "image": "2026-11-24T193223.235_832110399_1795548641076510.png"
 },
 {
  "line": "never see the names of",
  "image": "2026-11-24T193223.315_751405508_1795548642948984.png"
 },
 {
  "line": "Dubai's ruling sheikhs",
  "image": "2026-11-24T193223.374_653392078_1795548644572354.png"
 },
 {
  "line": "on any billionaire list.",
  "image": "2026-11-24T193223.445_1066246467_1795548646267896.png"
 },
 {
  "line": "Elon Musk knows",
  "image": "2026-11-24T193223.532_1000734999_1795548648005185.png"
 },
 {
  "line": "he isn't really the richest",
  "image": "2026-11-24T193223.662_43160848_1795548649603700.png"
 },
 {
  "line": "or most powerful man",
  "image": "2026-11-24T193223.779_948777885_1795548651343673.png"
 },
 {
  "line": "alive. Here's why.",
  "image": "2026-11-24T193223.877_775111591_1795548652694818.png"
 },
 {
  "line": "Musk's trillion dollar",
  "image": "2026-11-24T193223.979_815813023_1795548654315567.png"
 },
 {
  "line": "fortune is tied up",
  "image": "2026-11-24T193224.101_892069607_1795548656045689.png"
 },
 {
  "line": "in shares of his companies.",
  "image": "2026-11-24T193224.184_338775766_1795548657679059.png"
 },
 {
  "line": "It's not sitting in his",
  "image": "2026-11-24T193224.255_787579777_1795548659426050.png"
 },
 {
  "line": "bank account.",
  "image": "2026-11-24T193224.559_819173902_1795548663038063.png"
 },
 {
  "line": "Even if he wanted to,",
  "image": "2026-11-24T193224.329_45111637_1795548661259618.png"
 },
 {
  "line": "he couldn't just sell those",
  "image": "2026-11-24T193224.963_1050870746_1795548669518769.png"
 },
 {
  "line": "shares and cash",
  "image": "2026-11-24T193224.657_19952248_1795548664595836.png"
 },
 {
  "line": "out a trillion dollars.",
  "image": "2026-11-24T193224.762_93217305_1795548666214018.png"
 },
 {
  "line": "A selloff that big",
  "image": "2026-11-24T193224.868_126957362_1795548667786770.png"
 },
 {
  "line": "could rattle the entire",
  "image": "2026-11-24T193225.059_638308202_1795548671136635.png"
 },
 {
  "line": "{US|u s} stock market,",
  "image": "2026-11-24T193225.147_550656140_1795548672835463.png"
 },
 {
  "line": "and a {US|u s} market crash",
  "image": "2026-11-24T193225.217_453605651_1795548674309252.png"
 },
 {
  "line": "can drag down the global",
  "image": "2026-11-24T193225.321_286822205_1795548675990968.png"
 },
 {
  "line": "economy. Second,",
  "image": "2026-11-24T193225.410_876617211_1795548677606031.png"
 },
 {
  "line": "the moment he starts selling,",
  "image": "2026-11-24T193225.535_391183949_1795548679299646.png"
 },
 {
  "line": "the supply of shares",
  "image": "2026-11-24T193225.636_827171052_1795548681212699.png"
 },
 {
  "line": "floods the market,",
  "image": "2026-11-24T193225.721_341453726_1795548683027622.png"
 },
 {
  "line": "but demand doesn't keep",
  "image": "2026-11-24T193225.795_263961888_1795548684917975.png"
 },
 {
  "line": "up. The price",
  "image": "2026-11-24T193225.873_430131361_1795548686482666.png"
 },
 {
  "line": "would collapse,",
  "image": "2026-11-24T193225.947_633029917_1795548688196106.png"
 },
 {
  "line": "and his trillion dollar",
  "image": "2026-11-24T193226.012_75606614_1795548690017619.png"
 },
 {
  "line": "companies would sell for",
  "image": "2026-11-24T193226.077_1029941418_1795548691726012.png"
 },
 {
  "line": "pennies on the dollar.",
  "image": "2026-11-24T193227.092_304057289_1795548693260147.png"
 },
 {
  "line": "Musk isn't going to shoot",
  "image": "2026-11-24T193227.173_137963737_1795548694998304.png"
 },
 {
  "line": "himself in the foot like",
  "image": "2026-11-24T193227.251_779652862_1795548696704785.png"
 },
 {
  "line": "that. Dubai's",
  "image": "2026-11-24T193227.335_855125833_1795548698464452.png"
 },
 {
  "line": "royal families,",
  "image": "2026-11-24T193227.408_50531786_1795548699903718.png"
 },
 {
  "line": "on the other hand,",
  "image": "2026-11-24T193227.629_732195423_1795548701526476.png"
 },
 {
  "line": "are believed to control",
  "image": "2026-11-24T193227.718_375705416_1795548703256332.png"
 },
 {
  "line": "enormous liquid wealth.",
  "image": "2026-11-24T193227.825_1050252678_1795548704910000.png"
 },
 {
  "line": "Cash, bank",
  "image": "2026-11-24T193227.925_424380533_1795548706500843.png"
 },
 {
  "line": "balances,",
  "image": "2026-11-24T193228.000_700420014_1795548708475063.png"
 },
 {
  "line": "gold, real estate,",
  "image": "2026-11-24T193228.089_297430499_1795548710277633.png"
 },
 {
  "line": "supercars.",
  "image": "2026-11-24T193228.215_289193065_1795548711941232.png"
 },
 {
  "line": "And nobody outside",
  "image": "2026-11-24T193228.331_563543492_1795548713744873.png"
 },
 {
  "line": "really knows where all",
  "image": "2026-11-24T193228.428_786922237_1795548715408408.png"
 },
 {
  "line": "of it comes from.",
  "image": "2026-11-24T193228.519_501133393_1795548717218874.png"
 },
 {
  "line": "So while Musk has net",
  "image": "2026-11-24T193228.611_342192280_1795548718813563.png"
 },
 {
  "line": "worth on paper,",
  "image": "2026-11-24T193228.838_183015301_1795548723655435.png"
 },
 {
  "line": "the sheikhs have liquidity,",
  "image": "2026-11-24T193228.764_975140619_1795548722085314.png"
 },
 {
  "line": "influence, and control",
  "image": "2026-11-24T193228.697_569505160_1795548720445384.png"
 },
 {
  "line": "of the system.",
  "image": "2026-11-24T193228.988_1055742253_1795548726811760.png"
 },
 {
  "line": "And even the richest",
  "image": "2026-11-24T193228.905_655828353_1795548725064971.png"
 },
 {
  "line": "man on paper has",
  "image": "2026-11-24T193229.151_762670423_1795548729895960.png"
 },
 {
  "line": "to play by the rules",
  "image": "2026-11-24T193229.077_433249287_1795548728509013.png"
 },
 {
  "line": "of that system.",
  "image": "2026-11-24T193229.301_773185749_1795548733195140.png"
 },
 {
  "line": "That's why he bows.",
  "image": "2026-11-24T193229.227_377255237_1795548731523506.png"
 }
]