 },
 {
  "line": "independence.",
  "image": "020.png"
 },
 {
  "line": "The young nation was chaotic,",
  "image": "021.png"
 },
 {
  "line": "and the Founding Fathers",
  "image": "022.png"
 },
 {
  "line": "believed it needed order",
  "image": "023.png"
 },
 {
  "line": "to function. So",
  "image": "024.png"
 },
 {
  "line": "they built a government whose",
  "image": "025.png"
 },
 {
