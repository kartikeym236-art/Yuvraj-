 },
 {
  "line": "most people lived close",
  "image": "010.png"
 },
 {
  "line": "to the land.",
  "image": "011.png"
 },
 {
  "line": "They grew their own food,",
  "image": "012.png"
 },
 {
  "line": "built their own homes,",
  "image": "013.png"
 },
 {
  "line": "and settled problems",
  "image": "014.png"
 },
 {
  "line": "within their own communities.",
  "image": "015.png"
 },
 {
  "line": "Nobody clocked in for",
  "image": "016.png"
 },
 {
  "line": "a boss. Then,",
  "image": "017.png"
 },
 {
  "line": "in {1776|seventeen seventy six},",
