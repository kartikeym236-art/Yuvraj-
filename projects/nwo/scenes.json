[
 {
  "line": "A New World Order is",
  "image": "2026-11-25T073655.176_410488637_1795592056356953.png"
 },
 {
  "line": "coming. But what",
  "image": "2026-11-25T073655.427_143620417_1795592058089190.png"
 },
 {
  "line": "exactly is it?",
  "image": "2026-11-25T073656.087_477438304_1795592059696000.png"
 },
 {
  "line": "And what does it mean for ordinary",
  "image": "2026-11-25T073656.315_534443189_1795592061571593.png"
 },
 {
  "line": "people like you and me?",
  "image": "2026-11-25T073656.508_838148746_1795592063237932.png"
 },
 {
  "line": "To understand it,",
  "image": "2026-11-25T073656.624_137683322_1795592065054210.png"
 },
 {
  "line": "you first need to understand",
  "image": "2026-11-25T073656.706_74046423_1795592067620003.png"
 },
 {
  "line": "the old world order.",
  "image": "2026-11-25T073656.780_3979385_1795592069641086.png"
 },
 {
  "line": "Long ago,",
  "image": "2026-11-25T073656.863_1030033275_1795592071457466.png"
 },
 {
  "line": "most people lived close",
  "image": "2026-11-25T073656.952_564741508_1795592073273774.png"
 },
 {
  "line": "to the land.",
  "image": "2026-11-25T073657.029_143056885_1795592075049946.png"
 },
 {
  "line": "They grew their own food,",
  "image": "2026-11-25T073657.092_737100800_1795592076899136.png"
 },
 {
  "line": "built their own homes,",
  "image": "2026-11-25T073657.165_593670333_1795592078716008.png"
 },
 {
  "line": "and settled problems",
  "image": "2026-11-25T073658.010_37686446_1795592080767432.png"
 },
 {
  "line": "within their own communities.",
  "image": "2026-11-25T073658.098_729437094_1795592082586221.png"
 },
 {
  "line": "Nobody clocked in for",
  "image": "2026-11-25T073658.179_477095895_1795592084431752.png"
 },
 {
  "line": "a boss. Then,",
  "image": "2026-11-25T073658.236_526821433_1795592086232930.png"
 },
 {
  "line": "in {1776|seventeen seventy six},",
  "image": "2026-11-25T073658.302_556273901_1795592087663755.png"
 },
 {
  "line": "America declared its",
  "image": "2026-11-25T073658.372_931234557_1795592089509718.png"
 },
 {
  "line": "independence.",
  "image": "2026-11-25T073658.443_210931669_1795592091430083.png"
 },
 {
  "line": "The young nation was chaotic,",
  "image": "2026-11-25T073658.527_279077912_1795592093203261.png"
 },
 {
  "line": "and the Founding Fathers",
  "image": "2026-11-25T073658.623_255997831_1795592095075276.png"
 },
 {
  "line": "believed it needed order",
  "image": "2026-11-25T073658.713_1067167468_1795592097084919.png"
 },
 {
  "line": "to function. So",
  "image": "2026-11-25T073659.137_189335912_1795592098612261.png"
 },
 {
  "line": "they built a government whose",
  "image": "2026-11-25T073659.247_578124224_1795592100116027.png"
 },
 {
  "line": "job was to keep the country",
  "image": "2026-11-25T073659.313_1060531766_1795592102150323.png"
 },
 {
  "line": "running. Over",
  "image": "2026-11-25T073659.391_727947982_1795592103695824.png"
 },
 {
  "line": "time, power that once",
  "image": "2026-11-25T073700.774_413143674_1795592105325024.png"
 },
 {
  "line": "sat with local communities",
  "image": "2026-11-25T073700.908_22274319_1795592107095115.png"
 },
 {
  "line": "moved to the government.",
  "image": "2026-11-25T073701.005_589987592_1795592109367424.png"
 },
 {
  "line": "Its rules and regulations",
  "image": "2026-11-25T073701.083_1041730826_1795592111097219.png"
 },
 {
  "line": "decided more and more",
  "image": "2026-11-25T073701.137_164767064_1795592113251374.png"
 },
 {
  "line": "of daily life.",
  "image": "2026-11-25T073701.187_841478697_1795592115201870.png"
 },
 {
  "line": "Then big industry",
  "image": "2026-11-25T073701.257_565178980_1795592117090637.png"
 },
 {
  "line": "teamed up with that power.",
  "image": "2026-11-25T073701.311_433935596_1795592118784415.png"
 },
 {
  "line": "Factories rose,",
  "image": "2026-11-25T073701.365_633922370_1795592120591624.png"
 },
 {
  "line": "and ordinary people",
  "image": "2026-11-25T073701.424_673246923_1795592122611060.png"
 },
 {
  "line": "went to work for fixed",
  "image": "2026-11-25T073701.641_879419657_1795592124698834.png"
 },
 {
  "line": "wages. At",
  "image": "2026-11-25T073701.701_493485339_1795592126589059.png"
 },
 {
  "line": "first, it worked fairly",
  "image": "2026-11-25T073701.760_281963712_1795592128206301.png"
 },
 {
  "line": "well. But the factories",
  "image": "2026-11-25T073701.820_883082332_1795592130175444.png"
 },
 {
  "line": "multiplied,",
  "image": "2026-11-25T073701.886_1010369285_1795592132312329.png"
 },
 {
  "line": "corruption grew,",
  "image": "2026-11-25T073701.941_504248433_1795592134101348.png"
 },
 {
  "line": "and then came the tech",
  "image": "2026-11-25T073702.004_970855839_1795592136130092.png"
 },
 {
  "line": "giants. The people",
  "image": "2026-11-25T073702.068_1005137473_1795592138134313.png"
 },
 {
  "line": "at the top collected most",
  "image": "2026-11-25T073702.128_1007879172_1795592140102848.png"
 },
 {
  "line": "of the wealth, while",
  "image": "2026-11-25T073702.225_32108586_1795592142014527.png"
 },
 {
  "line": "everyone else kept struggling.",
  "image": "2026-11-25T073702.287_813583846_1795592143908300.png"
 },
 {
  "line": "Everything you see running",
  "image": "2026-11-25T073702.362_173912744_1795592145742392.png"
 },
 {
  "line": "around you today?",
  "image": "2026-11-25T073702.416_73742822_1795592147287734.png"
 },
 {
  "line": "That's the old world",
  "image": "2026-11-25T073702.487_77932040_1795592148752751.png"
 },
 {
  "line": "order. So what's",
  "image": "2026-11-25T073702.564_568755662_1795592150358228.png"
 },
 {
  "line": "the new one? Artificial",
  "image": "2026-11-25T073702.632_846741598_1795592151934581.png"
 },
 {
  "line": "intelligence.",
  "image": "2026-11-25T073702.700_524733619_1795592153558906.png"
 },
 {
  "line": "{AI|a i} may be the ultimate",
  "image": "2026-11-25T073702.762_1067797237_1795592154981898.png"
 },
 {
  "line": "tool for keeping people",
  "image": "2026-11-25T073702.812_1071251862_1795592156404907.png"
 },
 {
  "line": "in line. Slowly,",
  "image": "2026-11-25T073702.881_337773667_1795592158076130.png"
 },
 {
  "line": "it's being plugged into everything.",
  "image": "2026-11-25T073702.949_937594463_1795592160020932.png"
 },
 {
  "line": "Now ask yourself:",
  "image": "2026-11-25T073703.112_1057876065_1795592161688841.png"
 },
 {
  "line": "if {AI|a i} ever causes",
  "image": "2026-11-25T073703.165_997960590_1795592163121334.png"
 },
 {
  "line": "a disaster,",
  "image": "2026-11-25T073703.236_237130518_1795592164752241.png"
 },
 {
  "line": "who takes the blame?",
  "image": "2026-11-25T073703.314_474522020_1795592166299096.png"
 },
 {
  "line": "Governments will say they",
  "image": "2026-11-25T073703.392_479768804_1795592168221770.png"
 },
 {
  "line": "don't understand how it works.",
  "image": "2026-11-25T073703.455_204390341_1795592169930493.png"
 },
 {
  "line": "{AI|a i} companies will say",
  "image": "2026-11-25T073703.520_330519475_1795592171568998.png"
 },
 {
  "line": "it's an independent system",
  "image": "2026-11-25T073703.588_209526595_1795592173289676.png"
 },
 {
  "line": "nobody fully controls.",
  "image": "2026-11-25T073703.641_659877334_1795592175055749.png"
 },
 {
  "line": "And both keep profiting,",
  "image": "2026-11-25T073703.700_274873224_1795592176976120.png"
 },
 {
  "line": "with no one held accountable.",
  "image": "2026-11-25T073703.774_57553863_1795592178619498.png"
 },
 {
  "line": "That's the core fear:",
  "image": "2026-11-25T073703.855_167212210_1795592180503731.png"
 },
 {
  "line": "{AI|a i} does every job,",
  "image": "2026-11-25T073703.924_1058309126_1795592182287440.png"
 },
 {
  "line": "and humans are left without",
  "image": "2026-11-25T073703.993_735560300_1795592184139799.png"
 },
 {
  "line": "a purpose. It",
  "image": "2026-11-25T073704.049_870125634_1795592186150784.png"
 },
 {
  "line": "may not play out exactly",
  "image": "2026-11-25T073704.117_973540202_1795592188086875.png"
 },
 {
  "line": "like that. But just",
  "image": "2026-11-25T073704.168_461418978_1795592189650452.png"
 },
 {
  "line": "like the old order was",
  "image": "2026-11-25T073704.244_903523105_1795592191721729.png"
 },
 {
  "line": "pushed onto ordinary",
  "image": "2026-11-25T073704.913_560408881_1795592193388798.png"
 },
 {
  "line": "people, the new",
  "image": "2026-11-25T073704.992_682959154_1795592195239075.png"
 },
 {
  "line": "one probably will be",
  "image": "2026-11-25T073705.072_339775727_1795592197412153.png"
 },
 {
  "line": "too. And from",
  "image": "2026-11-25T073705.113_691509432_1795592199085110.png"
 },
 {
  "line": "{2027|twenty twenty seven} on,",
  "image": "2026-11-25T073705.232_420779524_1795592200901717.png"
 },
 {
  "line": "the changes could hit faster",
  "image": "2026-11-25T073705.319_45617453_1795592202711293.png"
 },
 {
  "line": "than anyone expects.",
  "image": "2026-11-25T073705.531_720166189_1795592208293067.png"
 },
 {
  "line": "What do you think?",
  "image": "2026-11-25T073705.445_1065939728_1795592206350356.png"
 },
 {
  "line": "Tell me in the comments.",
  "image": "2026-11-25T073705.368_375653794_1795592204266599.png"
 }
]