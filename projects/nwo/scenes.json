 {
  "line": "everyone else kept struggling.",
  "image": "048.png"
 },
 {
  "line": "Everything you see running",
  "image": "049.png"
 },
 {
  "line": "around you today?",
  "image": "050.png"
 },
 {
  "line": "That's the old world",
  "image": "051.png"
 },
 {
  "line": "order. So what's",
  "image": "052.png"
 },
 {
  "line": "the new one? Artificial",
