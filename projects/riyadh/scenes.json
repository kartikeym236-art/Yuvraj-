[
 {
  "line": "Saudi Arabia's capital,",
  "image": "2026-11-25T123849.434_226860154_1795610207756401.png"
 },
 {
  "line": "Riyadh,",
  "image": "2026-11-25T123849.844_15839365_1795610209544817.png"
 },
 {
  "line": "has been hit again.",
  "image": "2026-11-25T123850.178_670755253_1795610211452919.png"
 },
 {
  "line": "Witnesses say the target",
  "image": "2026-11-25T123850.482_255518272_1795610213042573.png"
 },
 {
  "line": "was the same tower struck",
  "image": "2026-11-25T123850.760_681117998_1795610214543795.png"
 },
 {
  "line": "five days ago.",
  "image": "2026-11-25T123850.985_481901265_1795610215764645.png"
 },
 {
  "line": "And this time,",
  "image": "2026-11-25T123851.147_800354926_1795610217326486.png"
 },
 {
  "line": "the usual emergency",
  "image": "2026-11-25T123851.403_495638998_1795610218637511.png"
 },
 {
  "line": "alert never reached",
  "image": "2026-11-25T123851.497_87365773_1795610220176011.png"
 },
 {
  "line": "people's phones.",
  "image": "2026-11-25T123851.596_237417118_1795610221842920.png"
 },
 {
  "line": "But what the Houthis are demanding",
  "image": "2026-11-25T123851.685_886140872_1795610223672869.png"
 },
 {
  "line": "to end this war will",
  "image": "2026-11-25T123851.777_963369946_1795610225314434.png"
 },
 {
  "line": "shock you. This is",
  "image": "2026-11-25T123851.887_429165503_1795610226980964.png"
 },
 {
  "line": "the {80-floor|eighty floor} {PIF|p i f}",
  "image": "2026-11-25T123851.954_359941059_1795610228440860.png"
 },
 {
  "line": "Tower. It's",
  "image": "2026-11-25T123852.089_48828259_1795610230086190.png"
 },
 {
  "line": "where Saudi Arabia",
  "image": "2026-11-25T123852.143_808200319_1795610231703282.png"
 },
 {
  "line": "runs its roughly {$900 billion|nine hundred billion dollar}",
  "image": "2026-11-25T123852.195_790500210_1795610233453105.png"
 },
 {
  "line": "government investment fund.",
  "image": "2026-11-25T123852.302_960261037_1795610235141577.png"
 },
 {
  "line": "Last week,",
  "image": "2026-11-25T123852.375_399595608_1795610236638218.png"
 },
 {
  "line": "a Houthi missile reportedly",
  "image": "2026-11-25T123852.437_972036976_1795610238183956.png"
 },
 {
  "line": "wrecked several of its",
  "image": "2026-11-25T123852.502_9413621_1795610239862361.png"
 },
 {
  "line": "floors. The",
  "image": "2026-11-25T123852.567_631985424_1795610241387807.png"
 },
 {
  "line": "Saudi led coalition",
  "image": "2026-11-25T123852.637_291915238_1795610242837266.png"
 },
 {
  "line": "confirmed today's attack",
  "image": "2026-11-25T123852.699_1007095727_1795610244301600.png"
 },
 {
  "line": "but didn't name the building.",
  "image": "2026-11-25T123852.764_522960059_1795610245812840.png"
 },
 {
  "line": "No injuries have been",
  "image": "2026-11-25T123852.836_728965572_1795610247754403.png"
 },
 {
  "line": "reported so far,",
  "image": "2026-11-25T123852.907_93563957_1795610249263623.png"
 },
 {
  "line": "and the full details",
  "image": "2026-11-25T123852.969_970759626_1795610250610012.png"
 },
 {
  "line": "still aren't public.",
  "image": "2026-11-25T123853.032_470225346_1795610252278098.png"
 },
 {
  "line": "But this isn't about one",
  "image": "2026-11-25T123853.104_280427130_1795610253897358.png"
 },
 {
  "line": "building. On October",
  "image": "2026-11-25T123853.165_293559385_1795610255313430.png"
 },
 {
  "line": "{10th|tenth}, Riyadh's",
  "image": "2026-11-25T123853.283_160053869_1795610256995124.png"
 },
 {
  "line": "airport was hit,",
  "image": "2026-11-25T123853.355_381920780_1795610258415793.png"
 },
 {
  "line": "reportedly killing {12|twelve}",
  "image": "2026-11-25T123853.419_414936022_1795610259909621.png"
 },
 {
  "line": "people and injuring",
  "image": "2026-11-25T123853.483_221076097_1795610261511179.png"
 },
 {
  "line": "{309|three hundred nine}.",
  "image": "2026-11-25T123853.550_236543066_1795610263130964.png"
 },
 {
  "line": "The next day,",
  "image": "2026-11-25T123853.849_313170599_1795610264495113.png"
 },
 {
  "line": "it was hit again.",
  "image": "2026-11-25T123854.580_981126120_1795610266194641.png"
 },
 {
  "line": "This month, an Aramco",
  "image": "2026-11-25T123854.661_485546081_1795610267563332.png"
 },
 {
  "line": "tower was struck too.",
  "image": "2026-11-25T123854.714_237860626_1795610269138507.png"
 },
 {
  "line": "And Saudi Arabia had",
  "image": "2026-11-25T123854.789_336563992_1795610271072987.png"
 },
 {
  "line": "to cancel its biggest",
  "image": "2026-11-25T123855.002_570098331_1795610272553550.png"
 },
 {
  "line": "investor event,",
  "image": "2026-11-25T123855.061_355280421_1795610274206547.png"
 },
 {
  "line": "known as Davos",
  "image": "2026-11-25T123855.116_1010295813_1795610275921837.png"
 },
 {
  "line": "in the Desert.",
  "image": "2026-11-25T123855.196_560170476_1795610277665817.png"
 },
 {
  "line": "Look at the pattern.",
  "image": "2026-11-25T123855.261_748476304_1795610279149515.png"
 },
 {
  "line": "First the airport.",
  "image": "2026-11-25T123855.336_885709488_1795610280781879.png"
 },
 {
  "line": "Then the oil giant.",
  "image": "2026-11-25T123855.402_472065499_1795610282096788.png"
 },
 {
  "line": "Now the building that manages",
  "image": "2026-11-25T123855.469_1052781377_1795610283835346.png"
 },
 {
  "line": "the country's money.",
  "image": "2026-11-25T123855.547_1028822235_1795610285386951.png"
 },
 {
  "line": "My theory?",
  "image": "2026-11-25T123855.637_389751230_1795610286918716.png"
 },
 {
  "line": "The Houthis aren't just attacking",
  "image": "2026-11-25T123855.701_120874174_1795610288818423.png"
 },
 {
  "line": "buildings. They're",
  "image": "2026-11-25T123855.801_594619927_1795610290391020.png"
 },
 {
  "line": "attacking investor confidence.",
  "image": "2026-11-25T123855.864_971288248_1795610292014843.png"
 },
 {
  "line": "The message is simple:",
  "image": "2026-11-25T123855.944_740775819_1795610293778852.png"
 },
 {
  "line": "your money isn't safe",
  "image": "2026-11-25T123856.008_555070500_1795610295273235.png"
 },
 {
  "line": "here. And now the numbers.",
  "image": "2026-11-25T123856.096_493011920_1795610297177578.png"
 },
 {
  "line": "According to the Wall Street",
  "image": "2026-11-25T123856.157_286622055_1795610298845547.png"
 },
 {
  "line": "Journal, the Houthis",
  "image": "2026-11-25T123856.235_112086125_1795610300512621.png"
 },
 {
  "line": "are demanding {$51 billion|fifty one billion dollars}",
  "image": "2026-11-25T123856.316_733222864_1795610302461559.png"
 },
 {
  "line": "to stop. They also",
  "image": "2026-11-25T123856.395_119960466_1795610304043554.png"
 },
 {
  "line": "want Saudi Arabia",
  "image": "2026-11-25T123856.465_581839051_1795610305689809.png"
 },
 {
  "line": "to recognize their government",
  "image": "2026-11-25T123856.548_36132796_1795610307279462.png"
 },
 {
  "line": "in Yemen. Saudi",
  "image": "2026-11-25T123856.630_492244629_1795610309128059.png"
 },
 {
  "line": "Arabia hasn't said",
  "image": "2026-11-25T123856.727_309544654_1795610310775856.png"
 },
 {
  "line": "yes or no,",
  "image": "2026-11-25T123856.920_208830839_1795610312633189.png"
 },
 {
  "line": "and talks are still ongoing.",
  "image": "2026-11-25T123856.983_301677973_1795610314038920.png"
 },
 {
  "line": "So what do you think?",
  "image": "2026-11-25T123857.061_754591003_1795610316033820.png"
 },
 {
  "line": "Will Saudi Arabia take",
  "image": "2026-11-25T123857.126_349258623_1795610317632828.png"
 },
 {
  "line": "the deal, or will",
  "image": "2026-11-25T123857.196_223998904_1795610319196309.png"
 },
 {
  "line": "this fight keep going?",
  "image": "2026-11-25T123857.279_134940005_1795610320717605.png"
 },
 {
  "line": "Tell me in the comments,",
  "image": "2026-11-25T123857.338_604059297_1795610322114867.png"
 },
 {
  "line": "and follow for more.",
  "image": "2026-11-25T123857.388_205981235_1795610323597464.png"
 }
]