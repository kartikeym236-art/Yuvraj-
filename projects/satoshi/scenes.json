[
 {
  "line": "The person who created",
  "image": "2026-11-24T201106.583_524589475_1795550946413502.png"
 },
 {
  "line": "Bitcoin. Where",
  "image": "2026-11-24T201106.867_424278323_1795550947765138.png"
 },
 {
  "line": "is he today?",
  "image": "2026-11-24T201107.427_533381126_1795550949724770.png"
 },
 {
  "line": "Nobody knows.",
  "image": "2026-11-24T201107.709_978683660_1795550951132664.png"
 },
 {
  "line": "And here's the craziest",
  "image": "2026-11-24T201107.950_1737832_1795550952484330.png"
 },
 {
  "line": "part. Around",
  "image": "2026-11-24T201108.117_731532371_1795550954270496.png"
 },
 {
  "line": "{1.1|one point one} million",
  "image": "2026-11-24T201108.227_123792072_1795550955829460.png"
 },
 {
  "line": "Bitcoins are still",
  "image": "2026-11-24T201108.835_245978182_1795550957414199.png"
 },
 {
  "line": "sitting untouched in",
  "image": "2026-11-24T201108.925_695965462_1795550958991186.png"
 },
 {
  "line": "his wallets,",
  "image": "2026-11-24T201108.996_678227724_1795550960547076.png"
 },
 {
  "line": "worth roughly {100|one hundred}",
  "image": "2026-11-24T201109.087_293779594_1795550962486794.png"
 },
 {
  "line": "billion dollars today.",
  "image": "2026-11-24T201109.174_972553610_1795550964308878.png"
 },
 {
  "line": "This story begins",
  "image": "2026-11-24T201109.234_624570653_1795550966196653.png"
 },
 {
  "line": "in {2008|two thousand eight}.",
  "image": "2026-11-24T201109.287_979775916_1795550967931514.png"
 },
 {
  "line": "The world was in a financial",
  "image": "2026-11-24T201109.590_127245801_1795550969640765.png"
 },
 {
  "line": "crisis. Banks",
  "image": "2026-11-24T201109.653_321197660_1795550971266591.png"
 },
 {
  "line": "were failing,",
  "image": "2026-11-24T201109.720_195646586_1795550972961450.png"
 },
 {
  "line": "and people were losing",
  "image": "2026-11-24T201109.787_567247625_1795550974884444.png"
 },
 {
  "line": "trust in the banking system.",
  "image": "2026-11-24T201109.953_184487951_1795550976686043.png"
 },
 {
  "line": "Then, out of nowhere,",
  "image": "2026-11-24T201110.033_408571197_1795550978349980.png"
 },
 {
  "line": "someone calling himself",
  "image": "2026-11-24T201110.749_681280167_1795550980115634.png"
 },
 {
  "line": "Satoshi Nakamoto",
  "image": "2026-11-24T201110.819_396188094_1795550981817178.png"
 },
 {
  "line": "posts a nine page",
  "image": "2026-11-24T201110.897_310626543_1795550983311744.png"
 },
 {
  "line": "paper online.",
  "image": "2026-11-24T201110.960_576007861_1795550984855182.png"
 },
 {
  "line": "It explained Bitcoin,",
  "image": "2026-11-24T201111.036_29585391_1795550986467441.png"
 },
 {
  "line": "a digital currency",
  "image": "2026-11-24T201111.123_61622394_1795550987966217.png"
 },
 {
  "line": "that needed no bank",
  "image": "2026-11-24T201111.175_43660882_1795550989617006.png"
 },
 {
  "line": "and no middleman.",
  "image": "2026-11-24T201111.243_709358742_1795550990975455.png"
 },
 {
  "line": "In {2009|two thousand nine},",
  "image": "2026-11-24T201111.308_882252245_1795550992318480.png"
 },
 {
  "line": "the very first block",
  "image": "2026-11-24T201111.360_50156822_1795550993668123.png"
 },
 {
  "line": "of Bitcoin was created,",
  "image": "2026-11-24T201111.461_819018135_1795550995179361.png"
 },
 {
  "line": "known as the Genesis Block.",
  "image": "2026-11-24T201112.170_1053954708_1795550996964725.png"
 },
 {
  "line": "Inside it,",
  "image": "2026-11-24T201112.343_373705752_1795550998331255.png"
 },
 {
  "line": "Satoshi hid a newspaper",
  "image": "2026-11-24T201112.423_109545797_1795550999903229.png"
 },
 {
  "line": "headline about the government",
  "image": "2026-11-24T201112.491_896010223_1795551001557462.png"
 },
 {
  "line": "bailing out the banks.",
  "image": "2026-11-24T201112.548_208289934_1795551003204009.png"
 },
 {
  "line": "It was a direct jab",
  "image": "2026-11-24T201112.612_1012173453_1795551005014385.png"
 },
 {
  "line": "at the traditional banking",
  "image": "2026-11-24T201112.674_784899510_1795551006315808.png"
 },
 {
  "line": "system. In the",
  "image": "2026-11-24T201112.745_655468048_1795551007702347.png"
 },
 {
  "line": "early days,",
  "image": "2026-11-24T201112.809_177707816_1795551008971063.png"
 },
 {
  "line": "Satoshi mined Bitcoin",
  "image": "2026-11-24T201112.868_369194810_1795551010494417.png"
 },
 {
  "line": "himself and",
  "image": "2026-11-24T201112.931_509944029_1795551012092570.png"
 },
 {
  "line": "slowly built up around",
  "image": "2026-11-24T201113.011_479032847_1795551013680957.png"
 },
 {
  "line": "{1.1|one point one} million",
  "image": "2026-11-24T201113.066_145931955_1795551015441379.png"
 },
 {
  "line": "coins. Back",
  "image": "2026-11-24T201113.875_146041320_1795551016867596.png"
 },
 {
  "line": "then, they were worth almost",
  "image": "2026-11-24T201113.951_111650695_1795551018454627.png"
 },
 {
  "line": "nothing. Today,",
  "image": "2026-11-24T201114.010_282008813_1795551020307989.png"
 },
 {
  "line": "they're worth tens of billions",
  "image": "2026-11-24T201114.063_1051679438_1795551022021584.png"
 },
 {
  "line": "of dollars. Then,",
  "image": "2026-11-24T201114.131_657664_1795551023875956.png"
 },
 {
  "line": "in {2011|twenty eleven},",
  "image": "2026-11-24T201114.180_27896760_1795551025294096.png"
 },
 {
  "line": "Satoshi sent one",
  "image": "2026-11-24T201114.255_233406459_1795551027018417.png"
 },
 {
  "line": "last known message,",
  "image": "2026-11-24T201114.317_1035849525_1795551028702678.png"
 },
 {
  "line": "saying he had moved on",
  "image": "2026-11-24T201114.382_218514399_1795551030442946.png"
 },
 {
  "line": "to other things.",
  "image": "2026-11-24T201114.445_446286371_1795551032228695.png"
 },
 {
  "line": "And then he vanished from",
  "image": "2026-11-24T201114.501_426736600_1795551033725557.png"
 },
 {
  "line": "the internet completely.",
  "image": "2026-11-24T201115.451_1024977961_1795551038905647.png"
 },
 {
  "line": "Many people have claimed",
  "image": "2026-11-24T201114.551_392614811_1795551035687967.png"
 },
 {
  "line": "to be Satoshi since,",
  "image": "2026-11-24T201115.509_879136390_1795551042055438.png"
 },
 {
  "line": "but nobody has ever proved",
  "image": "2026-11-24T201115.382_56722244_1795551037143298.png"
 },
 {
  "line": "it. The wildest part?",
  "image": "2026-11-24T201115.799_161351482_1795551048755080.png"
 },
 {
  "line": "The person who built Bitcoin",
  "image": "2026-11-24T201115.580_679861106_1795551043311928.png"
 },
 {
  "line": "disappeared,",
  "image": "2026-11-24T201115.646_703931954_1795551045067640.png"
 },
 {
  "line": "yet the network keeps",
  "image": "2026-11-24T201115.730_641319476_1795551047065163.png"
 },
 {
  "line": "running perfectly to",
  "image": "2026-11-24T201115.930_594842402_1795551050179170.png"
 },
 {
  "line": "this day. So here's",
  "image": "2026-11-24T201116.034_403940834_1795551051886504.png"
 },
 {
  "line": "the question. If",
  "image": "2026-11-24T201116.123_634298913_1795551053536882.png"
 },
 {
  "line": "Bitcoin has no owner,",
  "image": "2026-11-24T201116.875_505763995_1795551055037477.png"
 },
 {
  "line": "no company,",
  "image": "2026-11-24T201116.947_91141702_1795551056879517.png"
 },
 {
  "line": "and no central authority,",
  "image": "2026-11-24T201116.996_902479368_1795551058698313.png"
 },
 {
  "line": "who decides its price?",
  "image": "2026-11-24T201117.070_655860410_1795551060125372.png"
 },
 {
  "line": "Tell me in the comments.",
  "image": "2026-11-24T201117.162_910115080_1795551061667194.png"
 }
]