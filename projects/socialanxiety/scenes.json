[
 {
  "line": "Imagine entering a room",
  "image": "704224294_1794392048222921.jpg"
 },
 {
  "line": "full of people.",
  "image": "793583135_1794392049384693.jpg"
 },
 {
  "line": "Suddenly, you don't know",
  "image": "144317160_1794392050350770.jpg"
 },
 {
  "line": "where to look,",
  "image": "388128505_1794392051293326.jpg"
 },
 {
  "line": "what to say,",
  "image": "961221060_1794392052165481.jpg"
 },
 {
  "line": "or how to act.",
  "image": "772416526_1794392053025127.jpg"
 },
 {
  "line": "You start thinking\u2026",
  "image": "101113615_1794392053880770.jpg"
 },
 {
  "line": "\"Are they judging me?",
  "image": "605762106_1794392054796896.jpg"
 },
 {
  "line": "Do I look weird?",
  "image": "602236854_1794392055987627.jpg"
 },
 {
  "line": "What if I say something stupid?\"",
  "image": "805867804_1794392056885141.jpg"
 },
 {
  "line": "This is called",
  "image": "179452083_1794392057739333.jpg"
 },
 {
  "line": "Social Anxiety.",
  "image": "623340167_1794392058714262.jpg"
 },
 {
  "line": "It's not simply being shy.",
  "image": "902804028_1794392059616367.jpg"
 },
 {
  "line": "It's an intense fear",
  "image": "993871606_1794392060528291.jpg"
 },
 {
  "line": "of being judged,",
  "image": "411536219_1794392061446217.jpg"
 },
 {
  "line": "embarrassed, or rejected",
  "image": "58819866_1794392062373976.jpg"
 },
 {
  "line": "by others.",
  "image": "57629748_1794392063386166.jpg"
 },
 {
  "line": "Your brain starts treating",
  "image": "507750382_1794392064276483.jpg"
 },
 {
  "line": "ordinary social situations",
  "image": "526292011_1794392065210365.jpg"
 },
 {
  "line": "like dangerous threats.",
  "image": "420586110_1794392066265887.jpg"
 },
 {
  "line": "Your heart races,",
  "image": "277951715_1794392067458057.jpg"
 },
 {
  "line": "your hands sweat,",
  "image": "363934479_1794392068314792.jpg"
 },
 {
  "line": "your mind goes blank,",
  "image": "229731544_1794392069214209.jpg"
 },
 {
  "line": "and sometimes,",
  "image": "73963326_1794392070091087.jpg"
 },
 {
  "line": "you just want to disappear.",
  "image": "172224934_1794392071020285.jpg"
 },
 {
  "line": "Even after a conversation ends,",
  "image": "311903471_1794392071860372.jpg"
 },
 {
  "line": "you replay every little thing",
  "image": "116726022_1794392072779994.jpg"
 },
 {
  "line": "you said,",
  "image": "76339584_1794392073635878.jpg"
 },
 {
  "line": "searching for mistakes",
  "image": "285211616_1794392074510720.jpg"
 },
 {
  "line": "that nobody else even noticed.",
  "image": "591756347_1794392075506480.jpg"
 },
 {
  "line": "And here's the cruelest part\u2026",
  "image": "578483481_1794392076451190.jpg"
 },
 {
  "line": "You desperately want",
  "image": "678050125_1794392077421377.jpg"
 },
 {
  "line": "human connection,",
  "image": "595405528_1794392078494967.jpg"
 },
 {
  "line": "but you're terrified",
  "image": "892377207_1794392079341269.jpg"
 },
 {
  "line": "of being seen.",
  "image": "683636900_1794392080202709.jpg"
 },
 {
  "line": "But remember,",
  "image": "1049037717_1794392081111548.jpg"
 },
 {
  "line": "people are usually too busy",
  "image": "229196946_1794392082085871.jpg"
 },
 {
  "line": "worrying about themselves",
  "image": "1023631725_1794392083049619.jpg"
 },
 {
  "line": "to judge you",
  "image": "739960885_1794392084871726.jpg"
 },
 {
  "line": "as much as you think.",
  "image": "515855120_1794392083936314.jpg"
 },
 {
  "line": "You don't need",
  "image": "26328842_1794392086698547.jpg"
 },
 {
  "line": "to impress everyone.",
  "image": "781460451_1794392085756707.jpg"
 },
 {
  "line": "You just need to stop",
  "image": "165679438_1794392088552799.jpg"
 },
 {
  "line": "treating every interaction",
  "image": "724287499_1794392087594388.jpg"
 },
 {
  "line": "like an examination.",
  "image": "275919752_1794392090288556.jpg"
 },
 {
  "line": "Because you're not performing",
  "image": "522912630_1794392089394064.jpg"
 },
 {
  "line": "on a stage.",
  "image": "750394971_1794392091208826.jpg"
 },
 {
  "line": "You're simply living your life.",
  "image": "962049323_1794392092097981.jpg"
 }
]