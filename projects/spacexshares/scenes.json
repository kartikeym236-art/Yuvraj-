  "line": "of the future.",
  "image": "2026-11-26T184713.751_217730654_1795718772898783.png"
 },
 {
  "line": "Curiosity,",
  "image": "2026-11-26T184714.798_633034239_1795718774625165.png"
 },
 {
  "line": "a dream, inspiration.",
