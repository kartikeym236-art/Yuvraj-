[
 {
  "line": "When Albert Einstein was asked",
  "image": "b3_01.png"
 },
 {
  "line": "if he believed in God,",
  "image": "b3_02.png"
 },
 {
  "line": "his answer shocked the world.",
  "image": "b3_08.png"
 },
 {
  "line": "He simply said,",
  "image": "b3_03.png"
 },
 {
  "line": "\"I believe in Spinoza's God.\"",
  "image": "b3_04.png"
 },
 {
  "line": "He wasn't talking about",
  "image": "b3_07.png"
 },
 {
  "line": "a man in the sky",
  "image": "b3_06.png"
 },
 {
  "line": "who answers prayers,",
  "image": "b2_13.jpg"
 },
 {
  "line": "grants miracles,",
  "image": "b2_11.jpg"
 },
 {
  "line": "or judges human behavior.",
  "image": "b2_16.jpg"
 },
 {
  "line": "Baruch Spinoza",
  "image": "b2_12.jpg"
 },
 {
  "line": "was a legendary philosopher",
  "image": "b2_14.jpg"
 },
 {
  "line": "who proposed a truly {mind-bending|mind bending} idea:",
  "image": "b2_17.jpg"
 },
 {
  "line": "God is not a creator",
  "image": "b2_18.jpg"
 },
 {
  "line": "who stands outside the universe.",
  "image": "b2_19.jpg"
 },
 {
  "line": "God is the universe.",
  "image": "b2_20.jpg"
 },
 {
  "line": "Every star,",
  "image": "b3_10.jpg"
 },
 {
  "line": "every black hole,",
  "image": "b3_09.jpg"
 },
 {
  "line": "every law of physics,",
  "image": "b3_05.jpg"
 },
 {
  "line": "and every single atom",
  "image": "b1_01.jpg"
 },
 {
  "line": "in your body",
  "image": "b1_02.jpg"
 },
 {
  "line": "is a literal piece",
  "image": "b1_03.jpg"
 },
 {
  "line": "of the divine.",
  "image": "b1_04.jpg"
 },
 {
  "line": "Under this incredible philosophy,",
  "image": "b1_05.jpg"
 },
 {
  "line": "there is absolutely no separation",
  "image": "b1_06.jpg"
 },
 {
  "line": "between the creator and the creation.",
  "image": "b1_07.jpg"
 },
 {
  "line": "The cosmos isn't just",
  "image": "b1_08.jpg"
 },
 {
  "line": "a cold, dead machine;",
  "image": "b1_09.jpg"
 },
 {
  "line": "it is a single, infinite,",
  "image": "b1_10.jpg"
 },
 {
  "line": "interconnected living organism.",
  "image": "b1_11.jpg"
 },
 {
  "line": "When you study science,",
  "image": "b1_12.jpg"
 },
 {
  "line": "math, or physics,",
  "image": "b1_13.jpg"
 },
 {
  "line": "you aren't just reading a textbook,",
  "image": "b1_14.jpg"
 },
 {
  "line": "you are quite literally decoding",
  "image": "b1_15.jpg"
 },
 {
  "line": "the very thoughts of God.",
  "image": "b1_16.jpg"
 },
 {
  "line": "This means the universe",
  "image": "b1_17.jpg"
 },
 {
  "line": "doesn't judge you",
  "image": "b1_18.jpg"
 },
 {
  "line": "and it doesn't test you,",
  "image": "b1_19.jpg"
 },
 {
  "line": "it simply exists.",
  "image": "b1_20.jpg"
 },
 {
  "line": "You are not just a tiny,",
  "image": "b2_02.jpg"
 },
 {
  "line": "meaningless speck",
  "image": "b2_03.jpg"
 },
 {
  "line": "trapped inside the void,",
  "image": "b2_01.jpg"
 },
 {
  "line": "you are the universe",
  "image": "b2_05.jpg"
 },
 {
  "line": "temporarily waking up",
  "image": "b2_04.jpg"
 },
 {
  "line": "to experience itself.",
  "image": "b2_06.jpg"
 },
 {
  "line": "So the next time",
  "image": "b2_07.jpg"
 },
 {
  "line": "you look up",
  "image": "b2_10.jpg"
 },
 {
  "line": "at the stars,",
  "image": "b2_09.jpg"
 },
 {
  "line": "remember you are just",
  "image": "b2_08.jpg"
 },
 {
  "line": "looking in a mirror.",
  "image": "b2_15.jpg"
 }
]