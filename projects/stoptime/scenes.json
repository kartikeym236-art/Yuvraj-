[
 {
  "line": "What if you could stop time?",
  "image": "197119961_1794378398239132.jpg"
 },
 {
  "line": "Everything freezes,",
  "image": "116579885_1794378407942331.jpg"
 },
 {
  "line": "except you.",
  "image": "641594092_1794378400389766.jpg"
 },
 {
  "line": "You pull her back",
  "image": "304236218_1794378401506892.jpg"
 },
 {
  "line": "to the curb",
  "image": "806428689_1794378402488136.jpg"
 },
 {
  "line": "and press play.",
  "image": "823289013_1794378403410819.jpg"
 },
 {
  "line": "She thinks it was luck.",
  "image": "858262377_1794378404375729.jpg"
 },
 {
  "line": "Alarm: pause.",
  "image": "880639696_1794378406839950.jpg"
 },
 {
  "line": "{10|ten} more hours",
  "image": "606979105_1794378411011551.jpg"
 },
 {
  "line": "of sleep.",
  "image": "1009627322_1794378415035375.jpg"
 },
 {
  "line": "Someone insults you: pause.",
  "image": "560634900_1794378416746854.jpg"
 },
 {
  "line": "You take",
  "image": "1071778381_1794378417975333.jpg"
 },
 {
  "line": "{3|three} days",
  "image": "678512059_1794378418988373.jpg"
 },
 {
  "line": "to answer.",
  "image": "842884557_1794378419955458.jpg"
 },
 {
  "line": "He thinks you're a genius.",
  "image": "249125017_1794378421094889.jpg"
 },
 {
  "line": "Your exam starts",
  "image": "952307277_1794378422247367.jpg"
 },
 {
  "line": "in {5|five} minutes: pause.",
  "image": "876917491_1794378423233620.jpg"
 },
 {
  "line": "You study for a month.",
  "image": "424285268_1794378424193065.jpg"
 },
 {
  "line": "On your lunch break,",
  "image": "238512881_1794378425149710.jpg"
 },
 {
  "line": "you pause",
  "image": "208927643_1794378426197580.jpg"
 },
 {
  "line": "and walk around the world.",
  "image": "191370682_1794378427257055.jpg"
 },
 {
  "line": "Across the ocean,",
  "image": "147505015_1794378428222227.jpg"
 },
 {
  "line": "on frozen waves.",
  "image": "764558281_1794378429209093.jpg"
 },
 {
  "line": "Through Paris, Tokyo,",
  "image": "887559426_1794378430136530.jpg"
 },
 {
  "line": "the Pyramids.",
  "image": "118210134_1794378431068138.jpg"
 },
 {
  "line": "For {3|three} years.",
  "image": "1027464992_1794378431974845.jpg"
 },
 {
  "line": "When you come back,",
  "image": "786739856_1794378432869150.jpg"
 },
 {
  "line": "your coffee is still hot.",
  "image": "600914270_1794378433867150.jpg"
 },
 {
  "line": "In your paused world,",
  "image": "568723179_1794378434796579.jpg"
 },
 {
  "line": "nothing can touch you.",
  "image": "407218521_1794378435701062.jpg"
 },
 {
  "line": "Nothing can rush you.",
  "image": "555378440_1794378436589832.jpg"
 },
 {
  "line": "So you start pausing",
  "image": "59056518_1794378458414681.jpg"
 },
 {
  "line": "before everything.",
  "image": "782596552_1794378438477201.jpg"
 },
 {
  "line": "Every email,",
  "image": "887531328_1794378439397949.jpg"
 },
 {
  "line": "every call,",
  "image": "528672792_1794378440303050.jpg"
 },
 {
  "line": "every \"How are you?\"",
  "image": "125435294_1794378441206461.jpg"
 },
 {
  "line": "The girl from the bus:",
  "image": "502224577_1794378442067746.jpg"
 },
 {
  "line": "on your first date,",
  "image": "591856413_1794378442984807.jpg"
 },
 {
  "line": "you pause before every answer.",
  "image": "695477204_1794378443894911.jpg"
 },
 {
  "line": "She's never met",
  "image": "262511092_1794378444834145.jpg"
 },
 {
  "line": "a better listener.",
  "image": "14271849_1794378445740341.jpg"
 },
 {
  "line": "You marry her.",
  "image": "400527456_1794378446765010.jpg"
 },
 {
  "line": "She asks if you want kids.",
  "image": "18161623_1794378447801032.jpg"
 },
 {
  "line": "You think about it",
  "image": "12971139_1794378448771895.jpg"
 },
 {
  "line": "for {3|three} months.",
  "image": "428957908_1794378449822313.jpg"
 },
 {
  "line": "For her,",
  "image": "122516539_1794378450757040.jpg"
 },
 {
  "line": "you answered in a second.",
  "image": "156798906_1794378451720391.jpg"
 },
 {
  "line": "Your body doesn't age;",
  "image": "640470616_1794378452659124.jpg"
 },
 {
  "line": "your mind does.",
  "image": "1062371736_1794378453729760.jpg"
 },
 {
  "line": "{5|five} years of life,",
  "image": "787420128_1794378454802894.jpg"
 },
 {
  "line": "{200|two hundred} years",
  "image": "853292520_1794378455976066.jpg"
 },
 {
  "line": "in your head.",
  "image": "315889989_1794378457231610.jpg"
 },
 {
  "line": "Every time you press play,",
  "image": "1057807013_1794378437536593.jpg"
 },
 {
  "line": "the world feels louder.",
  "image": "102751202_1794378459696708.jpg"
 },
 {
  "line": "You don't belong in it anymore.",
  "image": "758256840_1794378461036935.jpg"
 },
 {
  "line": "So your pauses last for days,",
  "image": "98941447_1794378462226575.jpg"
 },
 {
  "line": "then years,",
  "image": "921788582_1794378463597055.jpg"
 },
 {
  "line": "then centuries.",
  "image": "29319777_1794378464627779.jpg"
 },
 {
  "line": "In here, there's no danger,",
  "image": "650407819_1794378465566982.jpg"
 },
 {
  "line": "no bills,",
  "image": "226819718_1794378466485657.jpg"
 },
 {
  "line": "no responsibilities.",
  "image": "589502956_1794378467430957.jpg"
 },
 {
  "line": "Nobody expects anything from you.",
  "image": "154061729_1794378468410720.jpg"
 },
 {
  "line": "One day,",
  "image": "458805871_1794378469312824.jpg"
 },
 {
  "line": "you can't remember her voice.",
  "image": "243939531_1794378470303479.jpg"
 },
 {
  "line": "So you press play.",
  "image": "797409286_1794378471285104.jpg"
 },
 {
  "line": "She's laughing at something",
  "image": "528710281_1794378472248465.jpg"
 },
 {
  "line": "you said a thousand years ago,",
  "image": "724083075_1794378473203721.jpg"
 },
 {
  "line": "and you don't recognize the sound.",
  "image": "685559295_1794378474150401.jpg"
 },
 {
  "line": "Too loud, too fast: pause.",
  "image": "998684417_1794378475116027.jpg"
 },
 {
  "line": "You have all the time",
  "image": "882312653_1794378476119854.jpg"
 },
 {
  "line": "in the world,",
  "image": "165128104_1794378477042898.jpg"
 },
 {
  "line": "and you're terrified",
  "image": "914316834_1794378477883022.jpg"
 },
 {
  "line": "of the next second.",
  "image": "1038428866_1794378478823487.jpg"
 }
]