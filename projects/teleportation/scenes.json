[
 {
  "line": "To teleport,",
  "image": "926347929_1794363422480923.jpg"
 },
 {
  "line": "you would first",
  "image": "394218880_1794363423685683.jpg"
 },
 {
  "line": "have to be destroyed.",
  "image": "582137779_1794363424643605.jpg"
 },
 {
  "line": "And whoever arrived",
  "image": "86958191_1794363425567204.jpg"
 },
 {
  "line": "would have your face,",
  "image": "712485958_1794363426699817.jpg"
 },
 {
  "line": "your voice,",
  "image": "976327184_1794363427672931.jpg"
 },
 {
  "line": "and all your memories.",
  "image": "17324605_1794363428564397.jpg"
 },
 {
  "line": "But it might not be you.",
  "image": "321909445_1794363429584983.jpg"
 },
 {
  "line": "And it wouldn't be",
  "image": "280514155_1794363431642849.jpg"
 },
 {
  "line": "a machine failure;",
  "image": "2030915_1794363457633123.jpg"
 },
 {
  "line": "it's imposed",
  "image": "436466609_1794363432529342.jpg"
 },
 {
  "line": "by the laws of physics.",
  "image": "1047526345_1794363433547833.jpg"
 },
 {
  "line": "Teleportation already exists,",
  "image": "14782189_1794363434484230.jpg"
 },
 {
  "line": "but only with particles.",
  "image": "133544144_1794363446942808.jpg"
 },
 {
  "line": "In {2017|twenty seventeen},",
  "image": "862283632_1794363436425918.jpg"
 },
 {
  "line": "it was achieved",
  "image": "788999695_1794363437451911.jpg"
 },
 {
  "line": "with particles of light",
  "image": "671140484_1794363438460908.jpg"
 },
 {
  "line": "between the ground and a satellite",
  "image": "1007989898_1794363439560334.jpg"
 },
 {
  "line": "at a distance of up to",
  "image": "870349738_1794363440538585.jpg"
 },
 {
  "line": "{1,400|one thousand four hundred} kilometers.",
  "image": "911703578_1794363441527970.jpg"
 },
 {
  "line": "What travels is not the particle,",
  "image": "814625994_1794363442605199.jpg"
 },
 {
  "line": "but its information.",
  "image": "804953672_1794363443900936.jpg"
 },
 {
  "line": "On the other side,",
  "image": "628684877_1794363444778667.jpg"
 },
 {
  "line": "a second particle receives it",
  "image": "902128457_1794363445823792.jpg"
 },
 {
  "line": "and becomes an exact replica",
  "image": "925414136_1794363450697661.jpg"
 },
 {
  "line": "of the first.",
  "image": "399272682_1794363447816344.jpg"
 },
 {
  "line": "But physics forbids",
  "image": "120370208_1794363448709458.jpg"
 },
 {
  "line": "copying a particle",
  "image": "164124261_1794363449766838.jpg"
 },
 {
  "line": "while preserving the original.",
  "image": "658107779_1794363435546976.jpg"
 },
 {
  "line": "Therefore, by reading it,",
  "image": "986455429_1794363451784448.jpg"
 },
 {
  "line": "its original state is destroyed.",
  "image": "555900441_1794363452768772.jpg"
 },
 {
  "line": "Now let's apply that rule",
  "image": "370652415_1794363453839931.jpg"
 },
 {
  "line": "to your body,",
  "image": "1009310586_1794363454697840.jpg"
 },
 {
  "line": "which contains about",
  "image": "608698784_1794363455696109.jpg"
 },
 {
  "line": "{7,000|seven thousand} quadrillion atoms.",
  "image": "387441897_1794363456693034.jpg"
 },
 {
  "line": "A machine would have to",
  "image": "71165065_1794363430638669.jpg"
 },
 {
  "line": "read all of them,",
  "image": "968728055_1794363458766436.jpg"
 },
 {
  "line": "and that scanning",
  "image": "143209959_1794363459805444.jpg"
 },
 {
  "line": "would destroy you on Earth.",
  "image": "973381201_1794363460712076.jpg"
 },
 {
  "line": "Your information would travel",
  "image": "268856317_1794363461512445.jpg"
 },
 {
  "line": "to Mars",
  "image": "729191782_1794363462452022.jpg"
 },
 {
  "line": "at the speed of light.",
  "image": "189584122_1794363463308056.jpg"
 },
 {
  "line": "And there,",
  "image": "586965217_1794363465325903.jpg"
 },
 {
  "line": "an identical person",
  "image": "61285220_1794363464345032.jpg"
 },
 {
  "line": "would be assembled,",
  "image": "506584301_1794363467241200.jpg"
 },
 {
  "line": "atom by atom.",
  "image": "523194417_1794363466357103.jpg"
 },
 {
  "line": "They would open their eyes,",
  "image": "113375117_1794363468992505.jpg"
 },
 {
  "line": "remember stepping into the booth,",
  "image": "493043377_1794363468149261.jpg"
 },
 {
  "line": "and say,",
  "image": "610851018_1794363471131468.jpg"
 },
 {
  "line": "\"I've arrived.\"",
  "image": "388714311_1794363470037462.jpg"
 }
]