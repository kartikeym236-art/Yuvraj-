[
 {
  "line": "People who may have",
  "image": "877892869_1794364872901718.jpg"
 },
 {
  "line": "changed the world,",
  "image": "529817882_1794364873825448.jpg"
 },
 {
  "line": "but vanished.",
  "image": "217810867_1794364874701333.jpg"
 },
 {
  "line": "Number one:",
  "image": "210962461_1794364875648673.jpg"
 },
 {
  "line": "Nikola Tesla promised the globe",
  "image": "785759223_1794364876553087.jpg"
 },
 {
  "line": "free wireless electricity.",
  "image": "1045196897_1794364877520793.jpg"
 },
 {
  "line": "The moment investors realized",
  "image": "714951105_1794364878505110.jpg"
 },
 {
  "line": "they couldn't meter it,",
  "image": "563999710_1794364879531189.jpg"
 },
 {
  "line": "they killed his funding.",
  "image": "311473009_1794364880475345.jpg"
 },
 {
  "line": "Upon his death,",
  "image": "277399963_1794364881391807.jpg"
 },
 {
  "line": "federal agents seized his research.",
  "image": "454509944_1794364882371006.jpg"
 },
 {
  "line": "It never saw",
  "image": "179743193_1794364883321653.jpg"
 },
 {
  "line": "the light of day.",
  "image": "1042775111_1794364884376394.jpg"
 },
 {
  "line": "Number two:",
  "image": "681390676_1794364885640584.jpg"
 },
 {
  "line": "Stanley Meyer engineered a vehicle",
  "image": "409431306_1794364886674576.jpg"
 },
 {
  "line": "that ran entirely on water.",
  "image": "1020770587_1794364887576775.jpg"
 },
 {
  "line": "He proved it worked in public.",
  "image": "939732974_1794364888478749.jpg"
 },
 {
  "line": "Weeks later,",
  "image": "920451920_1794364889519463.jpg"
 },
 {
  "line": "he collapsed at a restaurant",
  "image": "1033289055_1794364890475161.jpg"
 },
 {
  "line": "screaming he was poisoned.",
  "image": "448795837_1794364891449171.jpg"
 },
 {
  "line": "His prototype vanished overnight.",
  "image": "771377211_1794364892577775.jpg"
 },
 {
  "line": "Number three:",
  "image": "144597668_1794364893640645.jpg"
 },
 {
  "line": "MIT scientist Eugene Mallove",
  "image": "828332032_1794364894644522.jpg"
 },
 {
  "line": "chased cold fusion,",
  "image": "164094635_1794364895680361.jpg"
 },
 {
  "line": "a doorway",
  "image": "874285670_1794364896463235.jpg"
 },
 {
  "line": "to infinite clean energy.",
  "image": "624464955_1794364897288689.jpg"
 },
 {
  "line": "Before he could expose his findings,",
  "image": "497629632_1794364898300351.jpg"
 },
 {
  "line": "he was brutally murdered.",
  "image": "440278862_1794364899365245.jpg"
 },
 {
  "line": "The science faded to black.",
  "image": "477971203_1794364900489676.jpg"
 },
 {
  "line": "Number four:",
  "image": "988307172_1794364901603825.jpg"
 },
 {
  "line": "Royal Rife invented",
  "image": "63797609_1794364902632305.jpg"
 },
 {
  "line": "a frequency machine",
  "image": "839770108_1794364903768117.jpg"
 },
 {
  "line": "that targeted and shattered cancer cells",
  "image": "307177524_1794364904878711.jpg"
 },
 {
  "line": "without harming healthy tissue.",
  "image": "320633615_1794364905819505.jpg"
 },
 {
  "line": "Instead of a Nobel Prize,",
  "image": "1047347259_1794364906803524.jpg"
 },
 {
  "line": "his lab was raided,",
  "image": "301815844_1794364907997494.jpg"
 },
 {
  "line": "his equipment ruined,",
  "image": "462997772_1794364909271926.jpg"
 },
 {
  "line": "and his name erased.",
  "image": "480879326_1794364910218884.jpg"
 }
]