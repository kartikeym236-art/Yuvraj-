[
 {
  "line": "A World War Three script",
  "image": "2026-11-25T192715.697_1049620426_1795634705616025.png"
 },
 {
  "line": "posted on {4chan|four chan}",
  "image": "2026-11-25T192716.019_173527307_1795634707448972.png"
 },
 {
  "line": "is going viral,",
  "image": "2026-11-25T192716.923_108574310_1795634709355576.png"
 },
 {
  "line": "and its believers claim",
  "image": "2026-11-25T192717.150_604339527_1795634711185655.png"
 },
 {
  "line": "every prediction so",
  "image": "2026-11-25T192717.297_754397728_1795634713010184.png"
 },
 {
  "line": "far has come true.",
  "image": "2026-11-25T192717.387_928881675_1795634714983848.png"
 },
 {
  "line": "Here's the timeline it",
  "image": "2026-11-25T192717.470_573009729_1795634717045772.png"
 },
 {
  "line": "lays out. First,",
  "image": "2026-11-25T192717.555_864420028_1795634718655831.png"
 },
 {
  "line": "Israel breaks the ceasefire",
  "image": "2026-11-25T192717.619_438108358_1795634720441807.png"
 },
 {
  "line": "and strikes Iran.",
  "image": "2026-11-25T192717.703_229215093_1795634722947384.png"
 },
 {
  "line": "Then America responds,",
  "image": "2026-11-25T192717.774_694272012_1795634724343697.png"
 },
 {
  "line": "sending {B-2|b two} bombers to drop bunker busters",
  "image": "2026-11-25T192717.843_937054453_1795634725927191.png"
 },
 {
  "line": "on Iran's nuclear sites.",
  "image": "2026-11-25T192718.760_294175516_1795634730917491.png"
 },
 {
  "line": "Iran retaliates",
  "image": "2026-11-25T192717.922_315334046_1795634727563585.png"
 },
 {
  "line": "by hitting Gulf oil",
  "image": "2026-11-25T192718.006_347913343_1795634729312830.png"
 },
 {
  "line": "fields and {US|u s} bases,",
  "image": "2026-11-25T192718.813_888486180_1795634732657421.png"
 },
 {
  "line": "and blocks the Strait of",
  "image": "2026-11-25T192718.867_926243065_1795634734446803.png"
 },
 {
  "line": "Hormuz. Oil",
  "image": "2026-11-25T192718.918_972361281_1795634736098306.png"
 },
 {
  "line": "prices explode,",
  "image": "2026-11-25T192718.978_591687906_1795634737725327.png"
 },
 {
  "line": "and the {US|u s} sends",
  "image": "2026-11-25T192719.031_527627921_1795634739392946.png"
 },
 {
  "line": "three aircraft carriers.",
  "image": "2026-11-25T192719.086_352546875_1795634741229360.png"
 },
 {
  "line": "The next step on the list?",
  "image": "2026-11-25T192719.143_1012031776_1795634743279095.png"
 },
 {
  "line": "Iran,",
  "image": "2026-11-25T192719.198_1039984852_1795634744852754.png"
 },
 {
  "line": "Russia and China team",
  "image": "2026-11-25T192719.277_940999584_1795634746239890.png"
 },
 {
  "line": "up to sink two American",
  "image": "2026-11-25T192719.353_377284914_1795634747877176.png"
 },
 {
  "line": "carriers. The",
  "image": "2026-11-25T192719.399_843803899_1795634749220652.png"
 },
 {
  "line": "post says that's",
  "image": "2026-11-25T192719.450_387756539_1795634750830792.png"
 },
 {
  "line": "the turning point.",
  "image": "2026-11-25T192719.514_510510055_1795634752396998.png"
 },
 {
  "line": "Then it predicts Turkey",
  "image": "2026-11-25T192719.573_625710947_1795634753890546.png"
 },
 {
  "line": "leaves {NATO|nato} and",
  "image": "2026-11-25T192719.631_464814729_1795634755414543.png"
 },
 {
  "line": "joins Russia,",
  "image": "2026-11-25T192719.697_833204745_1795634757217648.png"
 },
 {
  "line": "China and Iran.",
  "image": "2026-11-25T192719.749_301852203_1795634758702441.png"
 },
 {
  "line": "And believers point",
  "image": "2026-11-25T192719.801_454916252_1795634760240791.png"
 },
 {
  "line": "out that Turkey's president",
  "image": "2026-11-25T192719.845_563944534_1795634761980116.png"
 },
 {
  "line": "has already called Israel's",
  "image": "2026-11-25T192719.900_685231133_1795634763624892.png"
 },
 {
  "line": "military actions",
  "image": "2026-11-25T192720.075_797040037_1795634765222394.png"
 },
 {
  "line": "a genocide.",
  "image": "2026-11-25T192720.147_1025265587_1795634767100136.png"
 },
 {
  "line": "Now the scariest part.",
  "image": "2026-11-25T192720.737_637067177_1795634768982423.png"
 },
 {
  "line": "The script claims {50|fifty}",
  "image": "2026-11-25T192720.790_269537948_1795634770435824.png"
 },
 {
  "line": "to {150|one hundred fifty}",
  "image": "2026-11-25T192720.850_42733093_1795634771989392.png"
 },
 {
  "line": "nuclear weapons get",
  "image": "2026-11-25T192720.907_153717265_1795634773745149.png"
 },
 {
  "line": "detonated high in the",
  "image": "2026-11-25T192721.104_498476698_1795634775712844.png"
 },
 {
  "line": "atmosphere,",
  "image": "2026-11-25T192721.158_223233522_1795634777419750.png"
 },
 {
  "line": "frying electronics",
  "image": "2026-11-25T192721.226_951280646_1795634779195403.png"
 },
 {
  "line": "in seconds.",
  "image": "2026-11-25T192721.287_57045873_1795634780785587.png"
 },
 {
  "line": "Phones, TVs,",
  "image": "2026-11-25T192721.363_175146261_1795634782486907.png"
 },
 {
  "line": "the power grid,",
  "image": "2026-11-25T192721.438_130878036_1795634784045254.png"
 },
 {
  "line": "gone.",
  "image": "2026-11-25T192721.488_174810689_1795634785629828.png"
 },
 {
  "line": "And then it goes full conspiracy.",
  "image": "2026-11-25T192721.544_491124795_1795634787364150.png"
 },
 {
  "line": "Three weeks later,",
  "image": "2026-11-25T192721.602_1027489898_1795634789133923.png"
 },
 {
  "line": "a fake alien invasion",
  "image": "2026-11-25T192721.667_1008921699_1795634790617616.png"
 },
 {
  "line": "called Project Blue Beam.",
  "image": "2026-11-25T192721.725_639286854_1795634792428460.png"
 },
 {
  "line": "Five billion people",
  "image": "2026-11-25T192721.786_369375011_1795634794126675.png"
 },
 {
  "line": "dead by {2027|twenty twenty seven}.",
  "image": "2026-11-25T192721.845_1022454402_1795634795905515.png"
 },
 {
  "line": "A one world government.",
  "image": "2026-11-25T192721.914_424850722_1795634797529113.png"
 },
 {
  "line": "And {FEMA|fema} camps sorting",
  "image": "2026-11-25T192721.968_931825707_1795634799170204.png"
 },
 {
  "line": "people by how useful",
  "image": "2026-11-25T192722.022_881272334_1795634800670252.png"
 },
 {
  "line": "they are. To be clear,",
  "image": "2026-11-25T192722.115_183528683_1795634802471128.png"
 },
 {
  "line": "most of this has zero",
  "image": "2026-11-25T192722.180_649590686_1795634804301569.png"
 },
 {
  "line": "evidence behind it,",
  "image": "2026-11-25T192722.345_509897884_1795634805744763.png"
 },
 {
  "line": "and anonymous internet",
  "image": "2026-11-25T192722.399_578458011_1795634807414676.png"
 },
 {
  "line": "posts can't see the",
  "image": "2026-11-25T192722.450_109890972_1795634809105636.png"
 },
 {
  "line": "future. The",
  "image": "2026-11-25T192722.507_696082850_1795634810620234.png"
 },
 {
  "line": "early \"predictions\" were",
  "image": "2026-11-25T192722.569_1030523933_1795634812756310.png"
 },
 {
  "line": "things many analysts",
  "image": "2026-11-25T192722.767_586321043_1795634814245690.png"
 },
 {
  "line": "already expected.",
  "image": "2026-11-25T192722.820_1062172106_1795634815950829.png"
 },
 {
  "line": "But here's the one thing believers",
  "image": "2026-11-25T192722.867_669715557_1795634817436394.png"
 },
 {
  "line": "say to watch.",
  "image": "2026-11-25T192722.934_206555886_1795634818835662.png"
 },
 {
  "line": "If two American aircraft",
  "image": "2026-11-25T192723.001_144506941_1795634820546619.png"
 },
 {
  "line": "carriers are ever sunk,",
  "image": "2026-11-25T192723.060_33242571_1795634822013430.png"
 },
 {
  "line": "they say the rest of the script",
  "image": "2026-11-25T192723.115_216242352_1795634823490622.png"
 },
 {
  "line": "starts coming true.",
  "image": "2026-11-25T192723.165_978257398_1795634824989558.png"
 },
 {
  "line": "So, do you buy it,",
  "image": "2026-11-25T192723.385_976636549_1795634832357474.png"
 },
 {
  "line": "or is it just internet",
  "image": "2026-11-25T192723.216_154758140_1795634826887885.png"
 },
 {
  "line": "fear? Tell me in the comments.",
  "image": "2026-11-25T192723.268_679754418_1795634828847008.png"
 }
]